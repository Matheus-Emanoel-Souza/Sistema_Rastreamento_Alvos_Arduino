<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RadarTorres.Experimentos</RootNamespace>
    <AssemblyName>RadarTorres.Experimentos</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Comentários <see cref="..."/> dos arquivos linkados apontam para tipos de UI que não
         entram aqui (ViewModels/Services) — isso é só documentação, não código. -->
    <NoWarn>$(NoWarn);CS1574;CS1580;CS1584;CS1658</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
  </ItemGroup>

  <!--
    Em vez de <ProjectReference> para RadarTorres.App, este executor compila DIRETAMENTE os
    MESMOS arquivos-fonte do motor de neuroevolução. Motivo: RadarTorres.App é WPF
    (net9.0-windows, UseWPF) e arrasta câmera, ONNX, serial e toda a UI — dependências
    irrelevantes para rodar episódios em console, e que fazem uma bateria longa depender de a
    UI estar compilando. Não há duplicação de lógica: são os arquivos originais, linkados; se
    o motor mudar, este executor muda junto. O appsettings.json carregado em runtime também é
    o de src/RadarTorres.App, então o layout de torres é idêntico ao do aplicativo.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\RadarTorres.App\NeuralEvolution\*.cs" LinkBase="Motor\NeuralEvolution" />
    <Compile Include="..\..\src\RadarTorres.App\Configuration\AppConfig.cs" LinkBase="Motor\Configuration" />
    <Compile Include="..\..\src\RadarTorres.App\Configuration\AppSettings.cs" LinkBase="Motor\Configuration" />
    <Compile Include="..\..\src\RadarTorres.App\Helpers\QuadrantHelper.cs" LinkBase="Motor\Helpers" />
    <Compile Include="..\..\src\RadarTorres.App\Helpers\DistanceCalculator.cs" LinkBase="Motor\Helpers" />
    <Compile Include="..\..\src\RadarTorres.App\Helpers\CalculadoraErroDisparo.cs" LinkBase="Motor\Helpers" />
    <Compile Include="..\..\src\RadarTorres.App\Models\SystemState.cs" LinkBase="Motor\Models" />
    <Compile Include="..\..\src\RadarTorres.App\Models\Target.cs" LinkBase="Motor\Models" />
    <Compile Include="..\..\src\RadarTorres.App\Models\Tower.cs" LinkBase="Motor\Models" />
    <Compile Include="..\..\src\RadarTorres.App\Models\GrauPerigoAlvo.cs" LinkBase="Motor\Models" />
  </ItemGroup>

</Project>
