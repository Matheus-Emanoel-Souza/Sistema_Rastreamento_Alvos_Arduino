erDiagram
    TABUSU ||--o{ TABMOD : "solicita"
    TABUSU ||--o| TABPRU : "tem"
    TABOBJ ||--o{ TABACA : "originou (quando houver)"
    TABOBJ ||--o{ TABOCE : "transita"
    TABCAM ||--o{ TABOBJ : "detectou (quadrante)"
    TABOBJ ||--o{ TABCLA : "classificou (velocidade/perigo)"

    TABUSU {
        int Id PK
        string Nome
        string Login UK
        string SenhaHash
        string SenhaSalt
        string Perfil
        bool Ativo
        datetime DataCriacao
        datetime UltimoAcesso "nullable"
    }

    TABOBJ {
        int Id PK
        string Tipo
        double X
        double Y
        double Z "nullable"
        string Quadrante
        datetime DataHora
        string Dispositivo
        double NivelConfianca "nullable"
        string Observacao "nullable"
        string ReferenciaImagem "nullable"
        int PerfilAlvoId "nullable"
        string CameraDispositivoId "nullable"
        string CameraNome "nullable"
        string RastreamentoId "nullable"
        string Estado "Detectado|AbatePendente|Abatido"
        datetime DataHoraUltimaDeteccao "nullable"
    }

    TABOCE {
        int Id PK
        int ObjetoDetectadoId FK
        string Estado "Detectado|AbatePendente|Abatido"
        datetime DataHora
        string Usuario "nullable - login de quem decidiu"
        string Observacao "nullable"
    }

    TABCAM {
        int Id PK
        string DispositivoId UK "moniker DirectShow"
        string Nome
        string Quadrante UK "Q1..Q4"
        datetime AtualizadoEm
    }

    TABACA {
        int ID_ACAO PK
        int ID_TORRE
        int ID_OBJETO FK "nullable"
        datetime DH_ACAO
        string OBSERVACAO "nullable"
    }

    TABMOD {
        int ID_MODO PK
        string MODOATUAL
        string MODOANTERIOR
        int ID_USER FK "nullable"
        datetime DHALTERACAO
    }

    TABPRU {
        int UsuarioId PK, FK
        string Idioma
        string Tema "Claro | Escuro | Sistema"
        bool SidebarRecolhida
        string TelaInicial "nullable"
        int RegistrosPorPagina
    }

    TABCLA {
        int Id PK
        int ObjetoDetectadoId FK "nullable"
        double VelocidadeMetrosPorSegundo
        string Grau "classificacao de perigo do alvo"
        datetime DataHora
    }

    TABHTG {
        int ID PK
        int GERACAO
        double MELHOR_FITNESS
        double FITNESS_MEDIO
        int ALVOS_ABATIDOS
        int ALVOS_ESCAPADOS
        datetime DH_REGISTRO
    }

    TABMFT {
        int Id PK
        int GeracaoMarco UK "marco a cada N geracoes"
        double FitnessMedioDoBloco
        double MelhorFitnessDoBloco
        datetime DataHora
    }

    TABICG {
        int Id PK
        int GeracaoMarco UK
        double Fitness
        int AlvosAbatidos
        int AlvosEscapados
        int TirosErrados
        double TaxaDeAcerto "nullable"
        double TaxaDeCobertura "nullable"
        string GenomaJson "vetor de pesos/vieses evoluido"
        datetime DataHora
    }

    TABDIC {
        int id PK
        string nometab UK "sigla de 6 letras, ex. TABOBJ"
        string nometabcompleta "ex. Tabela de Objetos Detectados"
    }

    TABOPC {
        int id PK
        string nometab "sigla da tabela, ex. TABCLA"
        string nomecampo "ex. Grau"
        string opcao "ex. Critico"
        string descricao "descricao em portugues da opcao"
    }
