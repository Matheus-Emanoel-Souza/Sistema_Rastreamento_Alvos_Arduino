flowchart TD
    INICIO(["Inicio"])

    INICIO --> SENSOR["Arduino varre o ambiente\ncom os 2 sensores ultrassonicos\n(angulo + distancia)"]
    INICIO --> CAM["Cameras capturam frames\npor quadrante"]

    SENSOR -- "Serial USB (texto)" --> CONV["App converte leitura em\nposicao cartesiana, determina\nquadrante e exibe no radar"]
    CAM --> VIS["Modulo de visao classifica\no alvo por cor, formato e tamanho"]

    CONV --> LOG1["Registra deteccao"]
    VIS --> LOG1

    LOG1 --> SEL["App seleciona a torre mais\nadequada: mesmo quadrante primeiro,\ndepois adjacente, depois sobressalente"]

    SEL --> CMD["Comando enviado ao Arduino"]
    CMD --> CHK{"Distancia minima de\nseguranca libera o\ndisparo?"}

    CHK -- "Nao" --> BLOQ["Acionamento bloqueado\ne motivo registrado no\nconsole de eventos"]
    CHK -- "Sim" --> ACAO["Torre aciona o alvo\n(laser/LED demonstrativo)"]

    ACAO --> AUD["Acao registrada em auditoria"]
    BLOQ --> AUD

    AUD --> FIM(["Fim do ciclo\n(volta a nova leitura)"])
    FIM -.-> INICIO
