// RadarTorres — Espelho DBML do modelo de dados atual
// Docs: https://dbml.dbdiagram.io/docs
//
// O protótipo NÃO usa um SGBD relacional hoje: a persistência é feita em arquivos CSV/JSON
// locais (ver src/RadarTorres.App/Repositories/ e src/RadarTorres.App/Services/*Repository.cs).
// Este arquivo é um ESPELHO desse modelo em DBML, para visualizar em https://dbdiagram.io
// (cole o conteúdo lá) — não é o banco em produção.
//
// Gerado a partir da leitura direta do código-fonte em 2026-09 (nomes de coluna e ordem
// batem exatamente com os CsvColumn<T> de cada *Repository.cs — ver Note de cada tabela).
// Colunas "FK por texto" (Login em vez de Id) refletem uma limitação real da implementação
// atual em CSV (sem integridade referencial) — comentadas abaixo em vez de um Ref formal.

Table usuarios {
  id integer [primary key]
  nome varchar
  login varchar [unique, note: 'Login único usado para autenticação']
  senha_hash varchar [note: 'PBKDF2-HMACSHA256, nunca texto puro']
  senha_salt varchar
  perfil varchar [note: 'Administrador | Operador | Visualizador']
  ativo boolean [default: true]
  data_criacao timestamp
  ultimo_acesso timestamp [note: 'NULL = nunca acessou']

  Note: 'usuarios.csv — CsvUsuarioRepository'
}

Table preferencias_usuario {
  usuario_id integer [primary key, note: 'FK 1:1 para usuarios.id']
  idioma varchar [default: 'pt-BR']
  tema varchar [default: 'Escuro', note: 'Claro | Escuro | Sistema']
  sidebar_recolhida boolean [default: false]
  tela_inicial varchar [note: 'NULL = padrão do sistema']
  registros_por_pagina integer [default: 25]

  Note: 'preferencias_usuario.csv — CsvPreferenciasUsuarioRepository (1:1 com usuarios)'
}

Table objetos_detectados {
  id integer [primary key]
  tipo varchar [note: 'hoje sempre "Alvo genérico"']
  x float
  y float
  z float [note: 'NULL hoje (sensores 2D); reservado p/ 3D futuro']
  quadrante varchar [note: 'ex.: "Q1"']
  data_hora timestamp
  dispositivo varchar [note: '"Arduino", "Simulador", ...']
  nivel_confianca float [note: '0..1, NULL se não medido']
  observacao varchar
  referencia_imagem varchar [note: 'foto de referência do perfil de alvo, quando a origem é câmera']
  perfil_alvo_id integer [note: 'alvo CADASTRADO que originou a ocorrência; NULL no radar/simulador']
  camera_dispositivo_id varchar [note: 'câmera que detectou (moniker DirectShow); NULL fora da câmera']
  camera_nome varchar
  rastreamento_id varchar [note: 'identidade da OCORRÊNCIA (acompanhamento entre quadros), não do alvo cadastrado']
  estado varchar [note: 'Detectado | AbatePendente | Abatido']
  data_hora_ultima_deteccao timestamp [note: 'avança enquanto o mesmo acompanhamento continua — em vez de criar linha nova']

  Note: 'Tabela ObjetosDetectados (SQLite) — SqliteObjetoDetectadoRepository. Uma linha por OCORRÊNCIA: único por (rastreamento_id, quadrante).'
}

Table ocorrencia_estados {
  id integer [primary key]
  objeto_detectado_id integer [note: 'FK para objetos_detectados.id']
  estado varchar [note: 'Detectado | AbatePendente | Abatido']
  data_hora timestamp
  usuario varchar [note: 'login do responsável, quando a transição partiu de ação humana']
  observacao varchar

  Note: 'Histórico de transições de estado da ocorrência (auditoria do ciclo de abate).'
}

Table cameras {
  id integer [primary key]
  dispositivo_id varchar [note: 'único — moniker DirectShow da câmera']
  nome varchar
  quadrante varchar [note: 'único — Q1..Q4; uma câmera por quadrante']
  atualizado_em timestamp

  Note: 'Qual câmera monitora qual quadrante — SqliteCameraQuadranteRepository.'
}

Ref: ocorrencia_estados.objeto_detectado_id > objetos_detectados.id

Table acoes_realizadas {
  id_acao integer [primary key]
  id_torre integer [note: 'identifica a torre que executou a ação (1..4)']
  id_objeto integer [note: 'FK para objetos_detectados.id — NULL se não houver objeto detectado associado']
  dh_acao timestamp
  observacao varchar

  Note: 'acoes_realizadas.csv — CsvAcaoRealizadaRepository. Só inserção (auditoria).'
}

Table modo_atual_torre {
  id_modo integer [primary key]
  modoatual varchar
  modoanterior varchar
  id_user integer [note: 'FK para usuarios.id — usuário que fez a alteração deste modo']
  dhalteracao timestamp

  Note: 'modo_atual_torre.csv — CsvModoAtualTorreRepository. Só inserção (auditoria).'
}

Table zona_mortas {
  id integer [primary key]
  name varchar
  type varchar [note: 'Quadrant | DistanceRange']
  quadrant varchar [note: 'relevante só quando type = Quadrant']
  min_distance float [note: 'relevante só quando type = DistanceRange']
  max_distance float
  enabled boolean [default: true]

  Note: 'zona-mortas.json — ZonaMortaRepository. Hoje é um único arquivo JSON por instalação, não uma tabela relacional.'
}

Table dashboard_card_layout {
  tela varchar [note: 'ex.: "Monitoramento", "PainelPrincipal"']
  usuario_id integer
  card_id varchar
  rel_x float [note: 'fração 0..1 do canvas']
  rel_y float
  rel_width float
  rel_height float
  is_visible boolean [default: true]
  z_index integer [default: 0]
  is_pinned_right boolean [default: false, note: 'só usado pelo card "Console de Eventos"']

  indexes {
    (tela, usuario_id, card_id) [pk]
  }

  Note: 'dashboard-layout-{tela}-{usuário}.json — DashboardLayoutRepository. Hoje é um arquivo JSON por tela+usuário.'
}

Table historico_treinamento_geracoes {
  id integer [primary key]
  geracao integer
  melhor_fitness float
  fitness_medio float
  alvos_abatidos integer
  alvos_escapados integer
  dh_registro timestamp

  Note: 'Tabela HistoricoTreinamentoGeracoes (SQLite) — SqliteHistoricoTreinamentoRepository. Buffer circular limitado a 300 linhas (descarta o ID mais antigo ao estourar); uma linha por geração treinada na tela "Treinamento do Controlador" (neuroevolução, ver src/RadarTorres.App/NeuralEvolution/).'
}

Table marcos_fitness_treinamento {
  id integer [primary key]
  geracao_marco integer [unique, note: 'a cada 500 gerações — 500, 1000, 1500...']
  fitness_medio_do_bloco float
  melhor_fitness_do_bloco float
  data_hora timestamp

  Note: 'Tabela MarcosFitnessTreinamento (SQLite) — SqliteMarcoFitnessTreinamentoRepository. Só inserção, sem limite de linhas (diferente de historico_treinamento_geracoes).'
}

Table instantaneos_comportamento_melhor_gene {
  id integer [primary key]
  geracao_marco integer [unique, note: 'a cada 1.000 gerações — 1000, 2000, 3000...']
  fitness float
  alvos_abatidos integer
  alvos_escapados integer
  tiros_errados integer [note: 'disparo autorizado que errou por sorte — ver Helpers/CalculadoraErroDisparo.cs']
  taxa_de_acerto float [note: 'abatidos / (abatidos + tiros_errados); NULL se nenhum disparo foi tentado']
  taxa_de_cobertura float [note: 'abatidos / (abatidos + escapados); NULL se nenhum alvo apareceu']
  genoma_json varchar [note: 'genoma completo (pesos+bias) serializado — permite recarregar e reproduzir o comportamento depois']
  data_hora timestamp

  Note: 'Tabela InstantaneosComportamentoMelhorGene (SQLite) — SqliteInstantaneoComportamentoRepository. Retrato completo do melhor genoma a cada 1.000 gerações; só inserção, nunca sobrescrito — histórico comparativo marco a marco.'
}

Table classificacoes_alvo {
  id integer [primary key]
  objeto_detectado_id integer [note: 'FK para objetos_detectados.id; NULL antes da primeira detecção ser gravada']
  velocidade_metros_por_segundo float
  grau varchar [note: 'Baixo | Medio | Alto | Critico — ver Helpers/ClassificadorPerigoAlvo.cs']
  data_hora timestamp

  Note: 'Tabela ClassificacoesAlvo (SQLite) — SqliteClassificacaoPerigoRepository. Só inserção (auditoria); uma linha por MUDANÇA de grau, não por leitura.'
}

Table arduino_settings {
  id integer [primary key, default: 1, note: 'singleton — sempre 1 linha']
  cli_path varchar
  placa_fqbn varchar
  porta_com varchar
  baud_rate integer
  ultimo_sketch_path varchar

  Note: 'arduino-settings.json — ArduinoSettingsRepository. Configuração única por instalação.'
}

Ref: preferencias_usuario.usuario_id - usuarios.id // one-to-one

Ref: dashboard_card_layout.usuario_id > usuarios.id // many-to-one

Ref: acoes_realizadas.id_objeto > objetos_detectados.id // many-to-one, opcional

Ref: modo_atual_torre.id_user > usuarios.id // many-to-one, opcional

Ref: classificacoes_alvo.objeto_detectado_id > objetos_detectados.id // many-to-one, opcional

// Fora deste espelho — objetos só em memória, nunca persistidos em disco:
//   Target, Tower, SensorReading, LogEntry, CameraDevice,
//   ArduinoCliInfo, ArduinoCompileResult, ArduinoCliOutputLine, ArduinoBoardOption
//
