<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RadarTorres.App</RootNamespace>
    <AssemblyName>RadarTorres.App</AssemblyName>
    <ApplicationIcon>Assets\RadarTorres.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Habilita restauração/publicação self-contained para win-x64 (ver build\publish.ps1
         e installer\RadarTorres.iss). Não força self-contained no "dotnet build" normal;
         isso só é ativado explicitamente via "dotnet publish -r win-x64 -p:SelfContained=true". -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- A interface é 100% pt-BR; sem isso o publish self-contained inclui satélites de
         recursos do WPF para ~30 idiomas (ru, tr, zh, ...), inflando o instalador à toa. -->
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Metadados do pacote/executável — usados pelo instalador (Inno Setup) e exibidos
       nas propriedades do .exe e em Programas e Recursos do Windows. -->
  <PropertyGroup>
    <Product>RadarTorres</Product>
    <AssemblyTitle>RadarTorres - Sistema de Rastreamento e Seleção de Torres</AssemblyTitle>
    <Description>Sistema de detecção, rastreamento e seleção de torres via Arduino (TCC).</Description>
    <Company>TCC - Engenharia da Computação</Company>
    <Copyright>Copyright © 2026</Copyright>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <NeutralLanguage>pt-BR</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <!-- Composition root (App.xaml.cs) — substitui o wiring manual de serviços que existia em
         MainWindow.xaml.cs, agora que o número de serviços/repositórios cresceu bastante
         (ver comentário original em Configuration/AppConfig.cs, que já previa esta migração). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />

    <!-- Persistência: todo registro do sistema grava exclusivamente em SQLite (radartorres.db)
         — ver os Sqlite*Repository em Repositories/. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />

    <!-- Módulo "Câmeras" (visualização em tempo real de webcams via DirectShow). Escolhida em
         vez de OpenCvSharp4/Emgu.CV por ser uma dependência ordens de grandeza menor — não traz
         um runtime nativo de visão computacional inteiro só para exibir uma prévia ao vivo — e
         por já cobrir exatamente o necessário: enumerar dispositivos com nome amigável e
         entregar quadros decodificados (ver CameraCaptureService). System.Drawing.Common é
         usado apenas dentro desse serviço, para decodificar o Bitmap do quadro em bytes BGR24
         crus antes de expor qualquer coisa para a ViewModel/View — aceitável aqui porque o
         projeto já é exclusivamente Windows (net9.0-windows, RuntimeIdentifiers=win-x64). -->
    <PackageReference Include="AForge.Video" Version="2.2.5" />
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />

    <!-- Detecção por visão computacional (card "Detecção por Câmera" em Monitoramento):
         roda o modelo tiny-yolov3-11.onnx já presente em ComputerVision/Models/YoloModel/
         dentro do próprio processo (ver OnnxYoloDetectionService) — mesma lógica de "sem
         processo externo" já adotada para o módulo Câmeras. System.Speech dá o anúncio por
         voz da distância (SAPI do Windows, builtin, sem modelo/arquivo extra). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permite que RadarTorres.Tests exercite membros internal usados exclusivamente para
         teste (ex.: montagem de argumentos e interpretação de código de saída do Arduino CLI
         em ArduinoCompilerService), sem torná-los API pública do projeto. -->
    <InternalsVisibleTo Include="RadarTorres.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- O mesmo arquivo usado em <ApplicationIcon> (ícone do .exe e das janelas) também
         precisa existir como Resource para ser carregado em tempo de execução por um pack
         URI — é assim que a tela de login o usa como marca d'água de fundo
         (ver Views/LoginView.xaml). <ApplicationIcon> sozinho grava o ícone só nos
         recursos Win32 do executável, de onde o XAML não consegue ler. -->
    <Resource Include="Assets\RadarTorres.ico" />

    <!-- Fontes da identidade visual (Chakra Petch / IBM Plex Sans / JetBrains Mono, todas OFL —
         licenças em Resources\Fonts\*-OFL.txt), embutidas porque o instalador é self-contained e
         a máquina do usuário final não tem essas fontes instaladas. Build Action "Resource" (não
         "Content"/"None") para ficarem dentro do assembly, referenciadas via
         "./Resources/Fonts/#<Nome da família>" em Styles/Typography.xaml. -->
    <Resource Include="Resources\Fonts\*.ttf" />

    <!-- Termos de Uso: o MESMO arquivo que o Inno Setup exibe como página de licença
         (installer\RadarTorres.iss) é embutido no executável, para a tela de Configurações e o
         PDF exportado lerem exatamente a redação aceita na instalação. Embutido, e não copiado
         para a pasta de saída, para não existir a possibilidade de o app rodar com uma cópia
         diferente da que o instalador apresentou. -->
    <EmbeddedResource Include="..\..\installer\TERMOS_DE_USO.txt"
                      Link="Resources\TERMOS_DE_USO.txt"
                      LogicalName="RadarTorres.App.Resources.TERMOS_DE_USO.txt" />

    <!-- Layout "padrão do sistema" de cada tela (posição/tamanho/visibilidade dos painéis, nas
         mesmas frações gravadas por IDashboardLayoutRepository.Save) — embutido no executável
         para já vir assim numa instalação nova, antes de qualquer usuário salvar um layout
         pessoal (ver DashboardLayoutRepository.LoadSystemDefault). -->
    <EmbeddedResource Include="Resources\DefaultLayouts\monitoramento.json"
                      LogicalName="RadarTorres.App.Resources.DefaultLayouts.monitoramento.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Arquivos de tradução (Requisito 1) — nunca strings hardcoded no código/XAML. -->
    <None Update="Resources\Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Modelo ONNX usado por OnnxYoloDetectionService — precisa ser copiado para o output
         (arquivos binários fora de Compile não são incluídos automaticamente pelo SDK). -->
    <None Update="ComputerVision\Models\YoloModel\*.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
