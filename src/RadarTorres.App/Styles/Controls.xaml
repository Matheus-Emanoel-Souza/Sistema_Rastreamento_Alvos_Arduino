<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Estilos GLOBAIS dos controles de formulário (ComboBox, TextBox, CheckBox) — corrige o bug
        de contraste relatado: várias telas definiam `<Style TargetType="ComboBox">` LOCAL (só
        Background/Foreground da caixa fechada), sem nenhum `<Style TargetType="ComboBoxItem">`
        correspondente — o popup da lista aberta então caía no estilo nativo do Windows
        (fundo branco), enquanto o Foreground continuava herdando a cor clara do tema escuro:
        texto claro sobre fundo claro, ilegível.

        Centralizado aqui (mesclado uma única vez em App.xaml, igual a Styles/Typography.xaml e
        Styles/Modal.xaml) em vez de repetido em cada UserControl/Window — é o pedido explícito
        de "evitar correções isoladas em cada página". Todas as cores usam DynamicResource dos
        tokens de Themes/Dark.xaml e Themes/Light.xaml, então o contraste já sai correto nos dois
        temas, sem duplicar nada aqui.

        Sem x:Key (implícito por TargetType): qualquer ComboBox/TextBox/CheckBox do aplicativo já
        usa isto automaticamente. Uma tela que realmente precisa de algo diferente continua livre
        para sobrepor localmente (resource local tem precedência sobre o de Application), mas
        deixa de ser necessário fazer isso só para corrigir contraste.
    -->

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Bg.Window}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Item da lista ABERTA do ComboBox — é este estilo que faltava em quase toda tela e
         causava o texto ilegível: sem ele, o popup usa fundo branco nativo do Windows. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource Selection.Subtle}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Selection.Solid}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Bg.Window}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
