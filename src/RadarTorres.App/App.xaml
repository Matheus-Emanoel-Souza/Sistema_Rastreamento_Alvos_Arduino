<Application x:Class="RadarTorres.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Sem StartupUri: o fluxo de abertura (login -> shell) é controlado por código em
        App.xaml.cs, já que depende de autenticação. As cores da paleta foram movidas para
        Themes/Dark.xaml e Themes/Light.xaml (Requisito "tema claro/escuro") — App.xaml.cs
        mescla o tema correto em Application.Resources antes de mostrar qualquer janela.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Ícones e tipografia da identidade visual — não variam por tema, por isso
                     ficam fora do ResourceDictionary trocado em runtime por ThemeService.ApplyTheme. -->
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <ResourceDictionary Source="Styles/Typography.xaml"/>
                <!-- Estilos das janelas modais de formulário (diretriz de UX: ações no canto
                     superior direito abrindo modal centralizado) — ver Styles/Modal.xaml. -->
                <ResourceDictionary Source="Styles/Modal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
