<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tema escuro — paleta original do projeto (idêntica aos valores que estavam
        hardcoded em App.xaml antes da funcionalidade de troca de tema). É o tema padrão
        do aplicativo, preservando 100% a aparência já existente.
    -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0F14"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#121821"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#26313D"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B98A5"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1C2530"/>

    <!--
        Cores do radar (fundo, grade, sweep) são propositalmente IGUAIS em ambos os temas —
        são cor de instrumento/visualização de dados, não "chrome" de UI, e o radar em si
        continua com fundo escuro mesmo no tema claro (convenção de display tipo
        radar/sonar). As cores semânticas de status (alvo, torre, aviso/perigo) mantêm o
        mesmo SIGNIFICADO nos dois temas, mas o tema claro usa tons um pouco mais escuros/
        saturados dos mesmos matizes para manter contraste adequado sobre fundo branco
        (Requisito 10 — acessibilidade); ver Themes/Light.xaml.
    -->
    <SolidColorBrush x:Key="RadarBackgroundBrush" Color="#050A0E"/>
    <SolidColorBrush x:Key="RadarGridBrush" Color="#1E4D2B"/>
    <SolidColorBrush x:Key="RadarSweepBrush" Color="#2ECC71"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2ECC71"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F1C40F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C"/>
    <SolidColorBrush x:Key="TargetBrush" Color="#3498DB"/>
    <SolidColorBrush x:Key="TargetSelectedBrush" Color="#F1C40F"/>
    <SolidColorBrush x:Key="TowerBrush" Color="#9B59B6"/>
    <SolidColorBrush x:Key="TowerSelectedBrush" Color="#2ECC71"/>
</ResourceDictionary>
