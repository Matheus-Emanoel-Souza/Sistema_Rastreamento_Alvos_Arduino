<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Tema escuro — nova identidade visual (tokens semânticos por função, não por tela).
        Mesmas chaves em Themes/Light.xaml; nenhuma view sabe qual tema está ativo, todas usam
        DynamicResource. Convenção de cor: âmbar = alvo/Modo Amarelo, mint = torre/ação
        principal/estado OK, vermelho = disparo — nunca usar essas cores para outro propósito.
    -->
    <SolidColorBrush x:Key="Bg.Window" Color="#0B1B1E"/>
    <SolidColorBrush x:Key="Bg.Sidebar" Color="#102A2E"/>
    <SolidColorBrush x:Key="Bg.Card" Color="#15353A"/>
    <SolidColorBrush x:Key="Border.Card" Color="Transparent"/>
    <SolidColorBrush x:Key="Border.Divider" Color="#1E4045"/>
    <SolidColorBrush x:Key="Border.Control" Color="#2A5A5C"/>
    <SolidColorBrush x:Key="Selection.Subtle" Color="#551A6F5C"/>
    <SolidColorBrush x:Key="Selection.Solid" Color="#1A6F5C"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#EEF7F3"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#B7D2CA"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#8FB3AA"/>
    <SolidColorBrush x:Key="Text.Neutral" Color="#6F948B"/>
    <SolidColorBrush x:Key="Accent.Fill" Color="#2BE5A6"/>
    <SolidColorBrush x:Key="Accent.Text" Color="#2BE5A6"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0B1B1E"/>
    <SolidColorBrush x:Key="Target.Fill" Color="#FFAE1F"/>
    <SolidColorBrush x:Key="Warning.Text" Color="#FFAE1F"/>
    <SolidColorBrush x:Key="Danger.Fill" Color="#FF5A4E"/>
    <SolidColorBrush x:Key="Danger.Text" Color="#FF8077"/>

    <!-- Quadrantes do radar (Q1/Q3 sombreados, ver RadarControl.xaml.cs). -->
    <SolidColorBrush x:Key="Radar.Quadrant1Fill" Color="#801A6F5C"/>
    <SolidColorBrush x:Key="Radar.Quadrant3Fill" Color="#E6134037"/>

    <!--
        O template nativo do MenuItem (usado pelo menu "Opções") não pinta o popup de
        submenu nem o destaque de hover a partir de Bg.Card/Accent.Fill — ele usa as
        cores de sistema do Windows (SystemColors), fixas independente do tema do app.
        Sem isto, o popup ficava sempre com fundo branco do Windows; combinado com o texto
        forçado para Text.Primary (quase branco aqui no tema escuro), o menu inteiro
        ficava invisível (texto branco sobre fundo branco).
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#15353A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#EEF7F3"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2BE5A6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0B1B1E"/>

    <!--
        Mesmo problema do MenuItem acima, mas para o popup de dropdown do ComboBox (e outros
        controles nativos que usam o "fundo de janela" padrão do Windows) — sem isto, abrir
        qualquer ComboBox no tema escuro mostrava a lista com fundo branco fixo.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#15353A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#EEF7F3"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#15353A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#EEF7F3"/>

    <!-- Opacidade da marca d'água do ícone no fundo da tela de login (ver LoginView.xaml).
         Mora no tema porque o ícone é uma imagem OPACA (quadrado verde-escuro com a torre):
         sobre o fundo quase preto deste tema ele some se for muito apagado, enquanto no tema
         claro o mesmo valor viraria uma mancha escura. Um valor por tema é o que mantém a
         marca perceptível nos dois sem competir com o formulário. -->
    <sys:Double x:Key="LoginMarcaDaguaOpacidade">0.22</sys:Double>

</ResourceDictionary>
