<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tema claro. Mesmas chaves de recurso do tema escuro (Themes/Dark.xaml) — nenhuma
        tela precisa saber qual tema está ativo, todas já usam DynamicResource.

        Paleta redesenhada para um verde bem claro (mesmo matiz do AccentBrush já usado em
        todo o app, só que bem mais claro/dessaturado) com detalhes em preto — em vez do
        branco/cinza-azulado neutro anterior. TextPrimaryBrush passa a ser preto quase puro
        (não mais o azul petróleo #16202A) para reforçar o "detalhes pretos" pedido.
    -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#E8F5EC"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F5FBF7"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#BFE0CC"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0B0F0C"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3F4A44"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>

    <!-- Ver comentário em Themes/Dark.xaml: cores de radar/status ficam iguais nos dois temas. -->
    <SolidColorBrush x:Key="RadarBackgroundBrush" Color="#050A0E"/>
    <SolidColorBrush x:Key="RadarGridBrush" Color="#1E4D2B"/>
    <SolidColorBrush x:Key="RadarSweepBrush" Color="#2ECC71"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#219150"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B7791F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="TargetBrush" Color="#2E75B6"/>
    <SolidColorBrush x:Key="TargetSelectedBrush" Color="#B7791F"/>
    <SolidColorBrush x:Key="TowerBrush" Color="#8E44AD"/>
    <SolidColorBrush x:Key="TowerSelectedBrush" Color="#219150"/>

    <!-- Ver comentário equivalente em Themes/Dark.xaml sobre por que essas SystemColors
         precisam ser sobrescritas (popup/hover do menu "Opções"). -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#F5FBF7"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#0B0F0C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#219150"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>

    <!-- Ver comentário equivalente em Themes/Dark.xaml sobre o popup de dropdown do ComboBox. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#F5FBF7"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#0B0F0C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#0B0F0C"/>
</ResourceDictionary>
