<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Tema claro. Mesmas chaves de recurso do tema escuro (Themes/Dark.xaml) — nenhuma
        tela precisa saber qual tema está ativo, todas já usam DynamicResource.
    -->
    <SolidColorBrush x:Key="Bg.Window" Color="#F1F7F5"/>
    <SolidColorBrush x:Key="Bg.Sidebar" Color="#E4F0EC"/>
    <SolidColorBrush x:Key="Bg.Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Border.Card" Color="#D3E5DE"/>
    <SolidColorBrush x:Key="Border.Divider" Color="#CFE3DC"/>
    <SolidColorBrush x:Key="Border.Control" Color="#A9CBC2"/>
    <SolidColorBrush x:Key="Selection.Subtle" Color="#3312A87B"/>
    <SolidColorBrush x:Key="Selection.Solid" Color="#BFE9DB"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#0F2A2E"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#35524D"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#4F716A"/>
    <SolidColorBrush x:Key="Text.Neutral" Color="#5E827A"/>
    <SolidColorBrush x:Key="Accent.Fill" Color="#12A87B"/>
    <SolidColorBrush x:Key="Accent.Text" Color="#0B7A5A"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0B1B1E"/>
    <SolidColorBrush x:Key="Target.Fill" Color="#FFAE1F"/>
    <SolidColorBrush x:Key="Warning.Text" Color="#9A5A00"/>
    <SolidColorBrush x:Key="Danger.Fill" Color="#D93B2F"/>
    <SolidColorBrush x:Key="Danger.Text" Color="#B3261E"/>

    <!-- Quadrantes do radar (Q1/Q3 sombreados, ver RadarControl.xaml.cs). -->
    <SolidColorBrush x:Key="Radar.Quadrant1Fill" Color="#4712A87B"/>
    <SolidColorBrush x:Key="Radar.Quadrant3Fill" Color="#2412A87B"/>

    <!-- Ver comentário equivalente em Themes/Dark.xaml sobre por que essas SystemColors
         precisam ser sobrescritas (popup/hover do menu "Opções"). -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#0F2A2E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#12A87B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>

    <!-- Ver comentário equivalente em Themes/Dark.xaml sobre o popup de dropdown do ComboBox. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#0F2A2E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#0F2A2E"/>

    <!-- Ver comentário equivalente em Themes/Dark.xaml. Bem mais apagada aqui: o quadrado
         escuro do ícone contrasta muito com o fundo claro deste tema. -->
    <sys:Double x:Key="LoginMarcaDaguaOpacidade">0.10</sys:Double>

</ResourceDictionary>
