<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tema claro. Mesmas chaves de recurso do tema escuro (Themes/Dark.xaml) — nenhuma
        tela precisa saber qual tema está ativo, todas já usam DynamicResource.
    -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D7DDE3"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#16202A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6B7A"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>

    <!-- Ver comentário em Themes/Dark.xaml: cores de radar/status ficam iguais nos dois temas. -->
    <SolidColorBrush x:Key="RadarBackgroundBrush" Color="#050A0E"/>
    <SolidColorBrush x:Key="RadarGridBrush" Color="#1E4D2B"/>
    <SolidColorBrush x:Key="RadarSweepBrush" Color="#2ECC71"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#219150"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B7791F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="TargetBrush" Color="#2E75B6"/>
    <SolidColorBrush x:Key="TargetSelectedBrush" Color="#B7791F"/>
    <SolidColorBrush x:Key="TowerBrush" Color="#8E44AD"/>
    <SolidColorBrush x:Key="TowerSelectedBrush" Color="#219150"/>
</ResourceDictionary>
