<UserControl x:Class="RadarTorres.App.Views.AcoesRealizadasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg.Window}"
             Foreground="{DynamicResource Text.Primary}"
             FontFamily="{DynamicResource Font.Body}">
    <!--
        Tela "Ações Realizadas" (Requisito 5 — auditoria de acionamentos). Os registros vêm de
        SqliteAcaoRealizadaRepository (radartorres.db) — a tela só lê a interface
        IAcaoRealizadaRepository.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AÇÕES REALIZADAS" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Accent.Fill}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Histórico de acionamentos (Requisito 5) — todo acionamento efetivamente executado fica registrado aqui."
                   Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,0,12"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Itens}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  Background="{DynamicResource Bg.Card}" Foreground="{DynamicResource Text.Primary}"
                  BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"
                  RowBackground="{DynamicResource Bg.Card}" AlternatingRowBackground="{DynamicResource Bg.Card}"
                  HorizontalGridLinesBrush="{DynamicResource Border.Divider}" VerticalGridLinesBrush="{DynamicResource Border.Divider}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Selection.Subtle}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Divider}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Torre" Binding="{Binding TorreNome}" Width="150"/>
                <DataGridTextColumn Header="Objeto Id" Binding="{Binding ObjetoDetectadoId, TargetNullValue=—}" Width="70"/>
                <DataGridTextColumn Header="X (m)" Binding="{Binding X, StringFormat={}{0:0.00}, TargetNullValue=—}" Width="70"/>
                <DataGridTextColumn Header="Y (m)" Binding="{Binding Y, StringFormat={}{0:0.00}, TargetNullValue=—}" Width="70"/>
                <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="150"/>
                <DataGridTextColumn Header="Observação" Binding="{Binding Observacao, TargetNullValue=—}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
