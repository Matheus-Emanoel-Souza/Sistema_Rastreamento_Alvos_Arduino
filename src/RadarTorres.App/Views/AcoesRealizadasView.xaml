<UserControl x:Class="RadarTorres.App.Views.AcoesRealizadasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI">
    <!--
        Tela "Ações Realizadas" (Requisito 5 — auditoria de acionamentos). Os registros vêm de
        ResilientAcaoRealizadaRepository: gravados em SQLite (radartorres.db) e, se o banco
        estiver indisponível, automaticamente em CSV local — a tela não sabe nem precisa saber
        qual dos dois foi usado, só lê a interface IAcaoRealizadaRepository.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AÇÕES REALIZADAS" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Histórico de acionamentos (Requisito 5) — toda tentativa autorizada, bloqueada ou com erro fica registrada aqui."
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Itens}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                  RowBackground="{DynamicResource PanelBrush}" AlternatingRowBackground="{DynamicResource InputBackgroundBrush}"
                  HorizontalGridLinesBrush="{DynamicResource PanelBorderBrush}" VerticalGridLinesBrush="{DynamicResource PanelBorderBrush}">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Dispositivo" Binding="{Binding Dispositivo}" Width="110"/>
                <DataGridTextColumn Header="Tipo de ação" Binding="{Binding TipoAcao}" Width="160"/>
                <DataGridTextColumn Header="X (m)" Binding="{Binding X, StringFormat={}{0:0.00}}" Width="70"/>
                <DataGridTextColumn Header="Y (m)" Binding="{Binding Y, StringFormat={}{0:0.00}}" Width="70"/>
                <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="150"/>
                <DataGridTextColumn Header="Usuário" Binding="{Binding UsuarioResponsavel, TargetNullValue=—}" Width="110"/>
                <DataGridTextColumn Header="Origem" Binding="{Binding Origem}" Width="90"/>
                <DataGridTextColumn Header="Resultado" Binding="{Binding Resultado}" Width="90"/>
                <DataGridTextColumn Header="Observação" Binding="{Binding Observacao, TargetNullValue=—}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
