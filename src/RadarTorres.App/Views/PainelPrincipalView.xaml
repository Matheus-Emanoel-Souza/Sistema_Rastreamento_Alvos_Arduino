<UserControl x:Class="RadarTorres.App.Views.PainelPrincipalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RadarTorres.App.Localization"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters">

    <UserControl.Resources>
        <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="{loc:Loc Dashboard.Title}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16"/>

            <WrapPanel Orientation="Horizontal">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dashboard.ObjetosDetectados}" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding TotalObjetosDetectados}" Style="{StaticResource CardValue}" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dashboard.AcoesRealizadas}" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding TotalAcoesRealizadas}" Style="{StaticResource CardValue}" Foreground="{DynamicResource TargetBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dashboard.ModoAtual}" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding ModoAtual}" Style="{StaticResource CardValue}" FontSize="16"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dashboard.EstadoComunicacao}" Style="{StaticResource CardLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding EstadoComunicacao, Converter={StaticResource ConnectionStateToBrushConverter}}"/>
                            <TextBlock Text="{Binding EstadoComunicacao}" Style="{StaticResource CardValue}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dashboard.UltimaAlteracaoModo}" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding UltimaAlteracaoModoTexto}" Style="{StaticResource CardValue}" FontSize="16"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dashboard.UsuarioResponsavel}" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding UsuarioResponsavelUltimaAlteracao}" Style="{StaticResource CardValue}" FontSize="16"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dashboard.UltimaAtualizacao}" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding UltimaAtualizacaoTexto}" Style="{StaticResource CardValue}" FontSize="16"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
