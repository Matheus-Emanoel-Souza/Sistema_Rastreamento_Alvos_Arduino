<UserControl x:Class="RadarTorres.App.Views.CameraPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RadarTorres.App.Localization"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters">
    <!--
        Um dos até 4 painéis da grade de câmeras (DataContext = CameraSlotViewModel). Além de
        visualizar, cada painel define o QUADRANTE que a sua câmera monitora (persistido) e roda
        a detecção por visão nessa câmera, registrando as ocorrências naquele quadrante. Reutilizada
        4 vezes por CamerasView.xaml (via ItemsControl) em vez de duplicar este XAML/lógica de
        binding 4 vezes — cada instância é totalmente independente porque cada CameraSlotViewModel
        tem sua própria ICameraCaptureService. Nenhuma lógica de captura mora aqui: só bindings,
        mesmo padrão de CamerasView.xaml original.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:QuadrantToLabelConverter x:Key="QuadrantToLabelConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{DynamicResource Border.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Danger.Fill}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Fill}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreviewBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Sidebar}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Height" Value="220"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource SectionCard}">
        <StackPanel>
            <!-- Identificação do painel = QUADRANTE monitorado (e não mais "Câmera N", que era
                 só a posição na grade). O nome do dispositivo continua no seletor abaixo. -->
            <TextBlock Text="{Binding TituloPainel}" FontSize="15" FontWeight="Bold"
                       TextWrapping="Wrap" Foreground="{DynamicResource Accent.Fill}"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableCameras}" SelectedItem="{Binding SelectedCamera}"
                          DisplayMemberPath="Name" Margin="0,0,6,0" IsEnabled="{Binding HasCameras}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{loc:Loc Cameras.Selecao.Iniciar}" Command="{Binding StartCommand}" Background="{DynamicResource Accent.Fill}"/>
                <Button Content="{loc:Loc Cameras.Selecao.Parar}" Command="{Binding StopCommand}"/>
            </StackPanel>

            <!-- Quadrante monitorado por esta câmera: um quadrante por câmera e uma câmera por
                 quadrante (o serviço transfere a responsabilidade se já houver outra ali). Sem
                 quadrante, a detecção deste painel permanece desligada. -->
            <TextBlock Text="{loc:Loc Cameras.Quadrante.Rotulo}" Style="{StaticResource LabelText}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Margin="0,0,6,0"
                          ItemsSource="{Binding QuadrantesDisponiveis}"
                          SelectedItem="{Binding QuadranteSelecionado}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource QuadrantToLabelConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="{loc:Loc Cameras.Quadrante.Salvar}" Margin="0"
                        Command="{Binding DefinirQuadranteCommand}" Background="{DynamicResource Accent.Fill}"
                        Foreground="White"/>
            </Grid>
            <TextBlock Text="{Binding QuadranteDescricao}" Style="{StaticResource LabelText}" TextWrapping="Wrap"/>

            <!-- Retorno da atribuição: confirmação ou recusa (quadrante já ocupado). -->
            <TextBlock Text="{Binding MensagemQuadrante}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                       Visibility="{Binding MensagemQuadrante, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Accent.Fill}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding QuadranteComErro}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Danger.Fill}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" Margin="0,8,0,8"/>

            <Border Style="{StaticResource PreviewBorder}">
                <Grid>
                    <Image Source="{Binding CurrentFrame}" Stretch="Uniform"
                           Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="{loc:Loc Cameras.Visualizacao.SemImagem}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240" FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStreaming}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <TextBlock Text="{Binding StatusDeteccao}" Style="{StaticResource LabelText}" TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding StatusDeteccao, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>
    </Border>
</UserControl>
