<UserControl x:Class="RadarTorres.App.Views.ArduinoSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RadarTorres.App.Localization"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters"
             xmlns:models="clr-namespace:RadarTorres.App.Models">
    <!--
        Aba "Configurações do Arduino": ambiente (localização do arduino-cli) + compilação de
        sketches + monitor serial. Segue o mesmo padrão visual de MonitoramentoView.xaml
        (GroupBox/Border com DynamicResource, mesma tipografia) — apenas bindings e
        encaminhamentos mínimos aqui; toda a lógica mora em ArduinoSettingsViewModel.
    -->

    <UserControl.Resources>
        <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter"/>
        <conv:ArduinoCompileStatusToBrushConverter x:Key="ArduinoCompileStatusToBrushConverter"/>
        <conv:ArduinoOutputStreamToBrushConverter x:Key="ArduinoOutputStreamToBrushConverter"/>
        <conv:BoolToFoundBrushConverter x:Key="BoolToFoundBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="ConsoleBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RadarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Height" Value="180"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="{loc:Loc Arduino.Title}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16"/>

            <!-- ==================== SEÇÃO 1 — AMBIENTE ARDUINO ==================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Arduino.Ambiente.Titulo}" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="{loc:Loc Arduino.Ambiente.CliPath}" Style="{StaticResource LabelText}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CliPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="{loc:Loc Arduino.Ambiente.Procurar}" Command="{Binding BrowseCliPathCommand}"/>
                        <Button Grid.Column="2" Content="{loc:Loc Arduino.Ambiente.DetectarAutomaticamente}" Command="{Binding AutoDetectCommand}" Margin="0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{Binding IsCliFound, Converter={StaticResource BoolToFoundBrushConverter}}"/>
                        <TextBlock Text="{Binding CliStatusText}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CliVersion, StringFormat='Versão: {0}', FallbackValue=''}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="18,2,0,0"
                               Visibility="{Binding IsCliFound, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="{loc:Loc Arduino.Ambiente.NaoEncontradoAjuda}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                               Foreground="{DynamicResource WarningBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCliFound}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{loc:Loc Arduino.Ambiente.Placa}" Style="{StaticResource LabelText}"/>
                            <ComboBox ItemsSource="{Binding AvailableBoards}" SelectedItem="{Binding SelectedBoard}" DisplayMemberPath="DisplayName"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Arduino.Ambiente.Porta}" Style="{StaticResource LabelText}"/>
                            <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"/>
                        </StackPanel>
                        <StackPanel Margin="0,8,8,0">
                            <TextBlock Text="{loc:Loc Arduino.Ambiente.BaudRate}" Style="{StaticResource LabelText}"/>
                            <ComboBox ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding SelectedBaudRate}"/>
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" VerticalAlignment="Bottom">
                            <Button Content="{loc:Loc Arduino.Ambiente.Atualizar}" Command="{Binding RefreshBoardsAndPortsCommand}" Margin="0"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ==================== SEÇÃO 2 — COMPILAÇÃO ==================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Arduino.Compilacao.Titulo}" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="{loc:Loc Arduino.Compilacao.Sketch}" Style="{StaticResource LabelText}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SketchPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="{loc:Loc Arduino.Compilacao.Selecionar}" Command="{Binding BrowseSketchCommand}" Margin="0"/>
                    </Grid>

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                        <Run Text="{loc:Loc Arduino.Compilacao.PlacaSelecionada}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding SelectedBoardName, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                        <Button Content="{loc:Loc Arduino.Compilacao.Compilar}" Command="{Binding CompileCommand}" Background="{DynamicResource AccentBrush}"/>
                        <Button Content="{loc:Loc Arduino.Compilacao.Cancelar}" Command="{Binding CancelCompileCommand}"/>
                        <Button Content="{loc:Loc Arduino.Compilacao.LimparConsole}" Command="{Binding ClearCompileConsoleCommand}"/>
                        <ProgressBar Width="120" Height="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                     IsIndeterminate="{Binding IsCompiling}"
                                     Visibility="{Binding IsCompiling, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding CompileStatusText}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"
                               Foreground="{Binding LastCompileStatus, Converter={StaticResource ArduinoCompileStatusToBrushConverter}}"/>

                    <Border Style="{StaticResource ConsoleBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CompileOutputLines}" Margin="6" FontFamily="Consolas" FontSize="12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ArduinoCliOutputLine}">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                   Foreground="{Binding Stream, Converter={StaticResource ArduinoOutputStreamToBrushConverter}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== SEÇÃO 3 — MONITOR SERIAL ==================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Arduino.Monitor.Titulo}" Style="{StaticResource SectionTitle}"/>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{loc:Loc Arduino.Ambiente.Porta}" Style="{StaticResource LabelText}"/>
                            <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Arduino.Ambiente.BaudRate}" Style="{StaticResource LabelText}"/>
                            <ComboBox ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding SelectedBaudRate}"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                        <Button Content="{loc:Loc Arduino.Monitor.Conectar}" Command="{Binding ConnectCommand}" Background="{DynamicResource AccentBrush}"/>
                        <Button Content="{loc:Loc Arduino.Monitor.Desconectar}" Command="{Binding DisconnectCommand}"/>
                        <Ellipse Width="12" Height="12" Margin="10,0,4,0" VerticalAlignment="Center"
                                 Fill="{Binding MonitorConnectionState, Converter={StaticResource ConnectionStateToBrushConverter}}"/>
                        <TextBlock Text="{Binding MonitorConnectionState}" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="{loc:Loc Arduino.Monitor.RolagemAutomatica}" IsChecked="{Binding AutoScroll}"/>
                        <CheckBox Content="{loc:Loc Arduino.Monitor.ExibirHorario}" IsChecked="{Binding ShowTimestamps}"/>
                        <Button Content="{loc:Loc Arduino.Monitor.LimparConsole}" Command="{Binding ClearMonitorConsoleCommand}" Margin="0,0,16,0"/>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{loc:Loc Arduino.Monitor.MensagensRecebidas}"/>
                            <Run Text=": "/>
                            <Run Text="{Binding MessageCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Style="{StaticResource ConsoleBorder}">
                        <ScrollViewer x:Name="MonitorScrollViewer" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding MonitorLines}" Margin="6" FontFamily="Consolas" FontSize="12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
