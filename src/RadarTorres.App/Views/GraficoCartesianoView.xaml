<UserControl x:Class="RadarTorres.App.Views.GraficoCartesianoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="120">
    <!--
        Controle de gráfico cartesiano genérico (linha ou barra), reutilizado por cada card da
        tela "Dashboards" (ver DashboardsView). O algoritmo de desenho é o MESMO já usado no
        gráfico "Evolução do Fitness" de TreinamentoControladorView (grade com rótulos + série
        escalada ao Canvas) — generalizado aqui para UMA série de pontos quaisquer (não mais só
        fitness), para também desenhar como barras, e com zoom/pan + destaque do melhor ponto e
        média móvel (pedido do usuário). Sem biblioteca de gráficos externa, de propósito (mesma
        decisão já tomada para o resto do projeto: nada que não precise de dependência nova).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="0"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Canvas x:Name="GraficoCanvas" Background="Transparent" ClipToBounds="True"
                    SizeChanged="GraficoCanvas_SizeChanged"
                    MouseWheel="GraficoCanvas_MouseWheel"
                    MouseLeftButtonDown="GraficoCanvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="GraficoCanvas_MouseLeftButtonUp"
                    MouseMove="GraficoCanvas_MouseMove"
                    MouseLeave="GraficoCanvas_MouseLeave"
                    Cursor="SizeWE"
                    ToolTip="Roda do mouse: zoom. Arrastar: mover. Botão 'Resetar zoom' quando ampliado."/>

            <Button x:Name="BotaoResetarZoom" Content="⊙ Resetar zoom" Click="BotaoResetarZoom_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                    Padding="8,3" FontSize="10" Cursor="Hand" Visibility="Collapsed"
                    Background="{DynamicResource Bg.Card}" Foreground="{DynamicResource Text.Secondary}"
                    BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"/>
        </Grid>

        <TextBlock x:Name="EixoXTexto" Grid.Row="1" FontSize="10" Margin="0,4,0,0"
                   FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}"/>
    </Grid>
</UserControl>
