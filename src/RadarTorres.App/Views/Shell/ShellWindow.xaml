<Window x:Class="RadarTorres.App.Views.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:RadarTorres.App.Views.Shell"
        xmlns:loc="clr-namespace:RadarTorres.App.Localization"
        Title="{loc:Loc App.Title}" Height="860" Width="1450" MinHeight="650" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <DockPanel>
        <shell:TopBarView DockPanel.Dock="Top"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <shell:SidebarView Grid.Column="0"/>

            <ContentControl x:Name="MainContent" Grid.Column="1" Margin="16"/>
        </Grid>
    </DockPanel>
</Window>
