<Window x:Class="RadarTorres.App.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RadarTorres.App.ViewModels"
        xmlns:loc="clr-namespace:RadarTorres.App.Localization"
        Title="{loc:Loc App.Title}" Height="860" Width="1450" MinHeight="650" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <!--
        Faixa de abas no estilo "guia de navegador" (Requisito): cada aba é uma sessão/login
        independente (ver SessionTabViewModel/App.OpenNewSession). Implementada com ItemsControl
        (não TabControl nativo) para poder colocar o botão "+" logo depois da última aba, dentro
        da mesma faixa horizontal — algo que o TabControl padrão não permite sem reescrever
        inteiro o template do painel de cabeçalhos.
    -->
    <Window.Resources>
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="✕" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NewTabButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="6,4,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4,8,0">
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SessionTabViewModel}">
                            <Button Click="TabHeader_Click" Tag="{Binding}" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="TabBg" Background="{DynamicResource BackgroundBrush}"
                                                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,1,1,0"
                                                            CornerRadius="6,6,0,0" Padding="12,7" Margin="0,0,3,0" MinWidth="120">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Header}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="140"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <Button Style="{StaticResource TabCloseButton}" Click="TabClose_Click" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <!-- IsSelected é mantido por MainWindow.xaml.cs sempre que a aba
                                                             ativa muda (ver SelectedTab) — aba ativa fica com o mesmo
                                                             fundo do conteúdo (PanelBrush), "colada" visualmente nele. -->
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource PanelBrush}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+" Style="{StaticResource NewTabButton}" Click="NewTab_Click"
                        ToolTip="{loc:Loc TopBar.NovaJanela}"/>
            </StackPanel>
        </Border>

        <ContentControl Content="{Binding SelectedTab.Content}"/>
    </DockPanel>
</Window>
