<UserControl x:Class="RadarTorres.App.Views.Shell.TopBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RadarTorres.App.Localization"
             xmlns:models="clr-namespace:RadarTorres.App.Models"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters">

    <UserControl.Resources>
        <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter"/>

        <!-- Estilo padrão (implícito) para todo MenuItem dentro deste UserControl que NÃO tenha
             um Style explícito — ver comentário original: substitui o template nativo do Windows
             (SystemColors fixas) para o popup/hover acompanharem o tema. -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="RowBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                       TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path x:Name="SubmenuArrow" Margin="16,0,0,0" VerticalAlignment="Center"
                                          Data="M0,0 L4,4 L0,8" Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Right" PlacementTarget="{Binding ElementName=RowBorder}"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Bg.Card}"
                                        BorderBrush="{DynamicResource Border.Card}"
                                        BorderThickness="1" CornerRadius="10" Padding="4" Margin="4,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" Margin="2"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Selection.Subtle}"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão secundário: fundo transparente, borda 1px Border.Control, texto Text.Primary,
             altura mínima 44px (Requisito "alvo de toque"), cantos 10px. -->
        <Style x:Key="TopBarButton" TargetType="Button">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MenuItem raiz "Opções": mesmo visual de botão secundário dos demais botões do
             cabeçalho, com o popup do submenu seguindo o tema (não as SystemColors nativas). -->
        <Style x:Key="OptionsMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="HeaderBorder" MinHeight="36"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                       TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path x:Name="Chevron" Margin="8,0,0,0" VerticalAlignment="Center"
                                          Data="M0,0 L4,4 L8,0" Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </StackPanel>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=HeaderBorder}"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Bg.Card}"
                                        BorderBrush="{DynamicResource Border.Card}"
                                        BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" Margin="2"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                                <Setter TargetName="Chevron" Property="Data" Value="M0,4 L4,0 L8,4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Bg.Window}" BorderBrush="{DynamicResource Border.Divider}"
            BorderThickness="0,0,0,1" Padding="20,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Título da página + chip de comunicação + ações de Opções/Nova página. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentPageTitle}" FontFamily="{DynamicResource Font.Display}"
                           FontWeight="Bold" FontSize="28" Foreground="{DynamicResource Text.Primary}"
                           VerticalAlignment="Center"/>

                <Border Background="{DynamicResource Bg.Card}" CornerRadius="12" Padding="10,5"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Fill="{Binding EstadoComunicacao, Converter={StaticResource ConnectionStateToBrushConverter}}"/>
                        <TextBlock Text="{Binding EstadoComunicacaoTexto}" FontFamily="{DynamicResource Font.Body}"
                                   FontSize="13" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Menu Background="Transparent" VerticalAlignment="Center" Margin="16,0,0,0">
                    <MenuItem Header="{loc:Loc TopBar.Options}" Style="{StaticResource OptionsMenuItem}">
                        <MenuItem Header="{loc:Loc TopBar.Language}">
                            <MenuItem Header="{loc:Loc TopBar.Language.Portuguese}" Command="{Binding SetLanguageCommand}" CommandParameter="pt-BR"/>
                            <MenuItem Header="{loc:Loc TopBar.Language.English}" Command="{Binding SetLanguageCommand}" CommandParameter="en-US"/>
                        </MenuItem>
                        <MenuItem Header="{loc:Loc TopBar.Theme}">
                            <MenuItem Header="{loc:Loc TopBar.Theme.Light}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:TemaPreferido.Claro}"/>
                            <MenuItem Header="{loc:Loc TopBar.Theme.Dark}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:TemaPreferido.Escuro}"/>
                            <MenuItem Header="{loc:Loc TopBar.Theme.System}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:TemaPreferido.Sistema}"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{loc:Loc Common.RestaurarPadrao}" Command="{Binding RestaurarPadraoCommand}"/>
                    </MenuItem>
                </Menu>

                <!-- Fora do menu "Opções" de propósito — cria login/sessão paralela, não é uma
                     preferência de configuração, então merece um botão próprio e visível. -->
                <Button Content="{loc:Loc TopBar.NovaJanela}" Command="{Binding NovaJanelaCommand}"
                        ToolTip="{loc:Loc TopBar.NovaJanelaDica}" Style="{StaticResource TopBarButton}"/>
            </StackPanel>

            <!-- Pílula do usuário: avatar + nome + crachá do perfil. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Selection.Solid}">
                    <TextBlock Text="{Binding IniciaisUsuario}" FontFamily="{DynamicResource Font.Body}" FontWeight="SemiBold"
                               FontSize="13" Foreground="{DynamicResource Text.Primary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding NomeUsuario}" FontFamily="{DynamicResource Font.Body}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Border Background="{DynamicResource Accent.Fill}" CornerRadius="6" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PerfilUsuario}" FontFamily="{DynamicResource Font.Mono}"
                               Foreground="{DynamicResource OnAccent}" FontSize="11" FontWeight="Medium"/>
                </Border>

                <Button x:Name="ProfileButton" Content="{loc:Loc TopBar.Profile}" Click="ProfileButton_Click" Style="{StaticResource TopBarButton}"/>
                <Button Content="{loc:Loc TopBar.Logout}" Command="{Binding LogoutCommand}" Style="{StaticResource TopBarButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
