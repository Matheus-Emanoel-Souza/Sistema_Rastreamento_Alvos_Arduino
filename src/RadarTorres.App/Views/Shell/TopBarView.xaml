<UserControl x:Class="RadarTorres.App.Views.Shell.TopBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RadarTorres.App.Localization"
             xmlns:models="clr-namespace:RadarTorres.App.Models">

    <UserControl.Resources>
        <!--
            Estilo padrão (implícito) para todo MenuItem dentro deste UserControl que NÃO tenha
            um Style explícito — ou seja, "Idioma", "Tema", os itens-folha (Português/Inglês,
            Claro/Escuro/Sistema) e "Restaurar padrão". Substitui o template nativo do Windows
            por um próprio: o template padrão pinta o fundo do popup de submenu e o destaque de
            hover com cores fixas do sistema operacional (SystemColors), que não acompanham o
            tema do app — por isso "Idioma"/"Tema" continuavam com popup branco fixo no tema
            escuro mesmo depois de ajustar só o Foreground. Aqui o fundo do popup usa
            DynamicResource (PanelBrush/PanelBorderBrush/AccentBrush), então segue o tema.
        -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="RowBorder" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                       TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path x:Name="SubmenuArrow" Margin="16,0,0,0" VerticalAlignment="Center"
                                          Data="M0,0 L4,4 L0,8" Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Right" PlacementTarget="{Binding ElementName=RowBorder}"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="4" Margin="4,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" Margin="2"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBarButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!--
            Estilo próprio para o MenuItem raiz "Opções", com o mesmo visual de botão dos
            botões Perfil/Sair (borda, padding, cursor de mão) em vez do texto nu que o
            template padrão do Windows renderia. O popup do submenu ganha borda arredondada
            e sombra usando as cores do próprio tema (PanelBrush/PanelBorderBrush) — não
            depende das SystemColors nativas, então acompanha o tema claro/escuro.
        -->
        <Style x:Key="OptionsMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                       TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path x:Name="Chevron" Margin="8,0,0,0" VerticalAlignment="Center"
                                          Data="M0,0 L4,4 L8,0" Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </StackPanel>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=HeaderBorder}"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" Margin="2"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Chevron" Property="Data" Value="M0,4 L4,0 L8,4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,0,0,1" Padding="12,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="{loc:Loc TopBar.Options}" Style="{StaticResource OptionsMenuItem}">
                        <MenuItem Header="{loc:Loc TopBar.Language}">
                            <MenuItem Header="{loc:Loc TopBar.Language.Portuguese}" Command="{Binding SetLanguageCommand}" CommandParameter="pt-BR"/>
                            <MenuItem Header="{loc:Loc TopBar.Language.English}" Command="{Binding SetLanguageCommand}" CommandParameter="en-US"/>
                        </MenuItem>
                        <MenuItem Header="{loc:Loc TopBar.Theme}">
                            <MenuItem Header="{loc:Loc TopBar.Theme.Light}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:TemaPreferido.Claro}"/>
                            <MenuItem Header="{loc:Loc TopBar.Theme.Dark}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:TemaPreferido.Escuro}"/>
                            <MenuItem Header="{loc:Loc TopBar.Theme.System}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:TemaPreferido.Sistema}"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{loc:Loc Common.RestaurarPadrao}" Command="{Binding RestaurarPadraoCommand}"/>
                    </MenuItem>
                </Menu>

                <!-- Fora do menu "Opções" de propósito — cria login/sessão paralela, não é uma
                     preferência de configuração, então merece um botão próprio e visível. -->
                <Button Content="{loc:Loc TopBar.NovaJanela}" Command="{Binding NovaJanelaCommand}"
                        ToolTip="{loc:Loc TopBar.NovaJanelaDica}" Style="{StaticResource TopBarButton}"/>
            </StackPanel>

            <!-- Nome + perfil do usuário logado, centralizados na barra (antes ficavam à
                 direita, precedidos do texto "Conectado como" — removido: o destaque visual do
                 nome maior + a pill de perfil já deixam isso implícito, sem precisar de rótulo). -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding NomeUsuario}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PerfilUsuario}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ProfileButton" Content="{loc:Loc TopBar.Profile}" Click="ProfileButton_Click" Style="{StaticResource TopBarButton}"/>
                <Button Content="{loc:Loc TopBar.Logout}" Command="{Binding LogoutCommand}" Style="{StaticResource TopBarButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
