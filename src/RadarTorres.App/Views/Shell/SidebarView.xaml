<UserControl x:Class="RadarTorres.App.Views.Shell.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RadarTorres.App.Localization">

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0">
        <Border.Style>
            <!--
                Largura animada (não só trocada instantaneamente) ao expandir/recolher — Duration
                de 200ms com EaseOut nos dois sentidos. EnterActions dispara quando o trigger fica
                verdadeiro (recolhendo: 210->52); ExitActions quando volta a falso (expandindo:
                52->210). O Setter continua definindo o valor final "de destino", a animação só
                cobre a transição visual até lá.
            -->
            <Style TargetType="Border">
                <Setter Property="Width" Value="210"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                        <Setter Property="Width" Value="52"/>
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width" To="52" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width" To="210" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel ClipToBounds="True">
            <!-- HorizontalContentAlignment="Center" (era "Left"): o ícone das 3 barras fica
                 sempre centralizado na largura atual do botão — como o botão ocupa a largura
                 inteira da barra lateral (DockPanel.Dock="Top", sem HorizontalAlignment
                 restringindo), ele acompanha sozinho a animação de largura acima: desliza da
                 posição "quase à esquerda" (52px) até o centro real da barra (210px) conforme
                 ela cresce, sem precisar de nenhuma transformação/animação própria no ícone. -->
            <Button DockPanel.Dock="Top" Command="{Binding ToggleSidebarCommand}"
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="16" Padding="14,12" HorizontalContentAlignment="Center" Cursor="Hand">
                <Button.Content>
                    <TextBlock Text="&#9776;"/>
                </Button.Content>
            </Button>

            <ItemsControl ItemsSource="{Binding MenuItems}" DockPanel.Dock="Top">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Item}"
                                ToolTip="{Binding Label}"
                                Cursor="Hand"
                                HorizontalContentAlignment="Left"
                                Padding="14,10" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
