<UserControl x:Class="RadarTorres.App.Views.Shell.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RadarTorres.App.Localization"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters">
    <UserControl.Resources>
        <conv:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometryConverter"/>
        <conv:GroupHeaderVisibilityConverter x:Key="GroupHeaderVisibilityConverter"/>
        <conv:CollapsedToAlignmentConverter x:Key="CollapsedToAlignmentConverter"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Divider}" BorderThickness="0,0,1,0">
        <Border.Style>
            <!--
                Largura animada (não só trocada instantaneamente) ao expandir/recolher — Duration
                de 200ms com EaseOut nos dois sentidos. EnterActions dispara quando o trigger fica
                verdadeiro (recolhendo: 248->76); ExitActions quando volta a falso (expandindo:
                76->248). O Setter continua definindo o valor final "de destino", a animação só
                cobre a transição visual até lá.
            -->
            <Style TargetType="Border">
                <Setter Property="Width" Value="248"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                        <Setter Property="Width" Value="76"/>
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width" To="76" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width" To="248" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel ClipToBounds="True">
            <!-- ==================== Logo + hambúrguer ==================== -->
            <Grid DockPanel.Dock="Top" Margin="0,20,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo expandido: ícone do app 40x40 + "RadarTorres" (Chakra Petch). -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,0,20,16" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="40" Height="40" CornerRadius="10" ClipToBounds="True">
                        <Image Stretch="UniformToFill">
                            <Image.Source>
                                <BitmapImage UriSource="pack://application:,,,/Assets/RadarTorres.ico" DecodePixelWidth="80"/>
                            </Image.Source>
                        </Image>
                    </Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Display}" FontWeight="Bold" FontSize="20">
                        <Run Text="Radar" Foreground="{DynamicResource Text.Primary}"/>
                        <Run Text="Torres" Foreground="{DynamicResource Accent.Text}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Logo compacto: só a torre, sem círculo/fundo (Requisito "barra estreita"). -->
                <Viewbox Grid.Row="0" Width="27" Height="36" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Viewbox.Style>
                        <Style TargetType="Viewbox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Viewbox.Style>
                    <Path Data="{StaticResource Icon.LogoTorre}" Fill="{DynamicResource Text.Primary}"/>
                </Viewbox>

                <!-- Hambúrguer: alterna 248px/76px (mesmo botão que antes alternava 210/52). -->
                <Button Grid.Row="1" Command="{Binding ToggleSidebarCommand}" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text.Secondary}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,8"
                        ToolTip="{loc:Loc Sidebar.Collapse}" AutomationProperties.Name="{loc:Loc Sidebar.Collapse}">
                    <TextBlock Text="&#9776;" FontSize="16"/>
                </Button>
            </Grid>

            <!-- ==================== Itens agrupados ==================== -->
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding MenuItems}" Margin="12,0,12,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Cabeçalho de grupo (só quando GroupLabel está definido — um por
                                     grupo, ver ShellViewModel.RebuildMenu) e só na barra expandida. -->
                                <TextBlock Text="{Binding GroupLabel}" FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Text.Neutral}"
                                           Margin="10,16,10,6">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource GroupHeaderVisibilityConverter}">
                                            <Binding Path="GroupLabel"/>
                                            <Binding Path="DataContext.IsSidebarCollapsed" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>

                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Item}" Cursor="Hand"
                                        ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                        Padding="12,11" Margin="0,0,0,2" BorderThickness="0"
                                        HorizontalContentAlignment="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource CollapsedToAlignmentConverter}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                            <Style.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                </Style>
                                            </Style.Resources>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Selection.Subtle}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Selection.Subtle}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding IconKey, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" Stretch="Uniform" VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Width" Value="18"/>
                                                    <Setter Property="Height" Value="18"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="Width" Value="22"/>
                                                            <Setter Property="Height" Value="22"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource Font.Body}"
                                                   FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
