<UserControl x:Class="RadarTorres.App.Views.EstatisticasTreinamentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg.Window}"
             Foreground="{DynamicResource Text.Primary}"
             FontFamily="{DynamicResource Font.Body}">
    <!--
        Tela "Estatísticas de Treinamento" — exclusiva do Administrador (ver PermissionService).
        Mostra a evolução de LONGO prazo do fitness médio a cada 500 gerações
        (IMarcoFitnessTreinamentoRepository), complementar à tela "Treinamento do Controlador"
        (que foca no treinamento rodando agora, geração a geração). Reaproveita os mesmos estilos
        de cartão/título usados nela e em ConfiguracoesView.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SemDadosCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TemDados}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent.Fill}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="{DynamicResource Border.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Estilo único das duas tabelas comparativas de hiperparâmetros (mesmas colunas, mesma
             leitura) — ver ExperimentoDataGridColunas logo abaixo. -->
        <Style x:Key="TabelaExperimento" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border.Divider}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Border.Divider}"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Divider}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <!-- Realce visual (requisito de identificar a melhor configuração de relance):
                         negrito+destaque na de melhor fitness, cinza nas que ainda não rodaram. -->
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MelhorFitness}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent.Fill}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Executado}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="ESTATÍSTICAS DE TREINAMENTO" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Análise experimental de hiperparâmetros (camada oculta e tamanho da população) e evolução do fitness médio a cada 500 gerações de neuroevolução — visão de longo prazo, sem o ruído geração a geração. Tela exclusiva do perfil Administrador."/>
                </StackPanel>
                <Button Content="Atualizar" Command="{Binding AtualizarCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--
                    ANÁLISE EXPERIMENTAL DE HIPERPARÂMETROS (pedida no parecer do artigo).
                    Duas tabelas no MESMO painel, cada configuração em uma linha: a primeira varia
                    só a quantidade de neurônios da camada oculta (população fixa no baseline), a
                    segunda varia só o tamanho da população (camada oculta fixa no baseline).
                    Separar as séries é o que permite atribuir a diferença de fitness ao
                    hiperparâmetro variado; mantê-las no mesmo painel é o que permite comparar as
                    duas de relance. Todas as linhas vêm de execuções REAIS registradas em
                    IExperimentoHiperparametrosRepository — configurações ainda não treinadas
                    aparecem em itálico com "não executado", nunca com valor estimado.
                    Ver EstatisticasTreinamentoViewModel e ExecutorExperimentosHiperparametros.
                -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ANÁLISE EXPERIMENTAL DE HIPERPARÂMETROS" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="11" FontWeight="Normal" Margin="0,0,0,10" TextWrapping="Wrap">
                            <Run Text="Um hiperparâmetro por vez, todo o resto idêntico:"/>
                            <Run Text="{Binding GeracoesPorExperimento, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="gerações por configuração, mesma função de fitness, mesmos cenários táticos e mesma taxa de mutação. Os dados abaixo são de execuções reais — nenhum valor é estimado."/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Executar configurações pendentes" Command="{Binding ExecutarExperimentosCommand}"
                                    ToolTip="Treina apenas as configurações do plano que ainda não têm execução registrada."/>
                            <Button Content="Refazer tudo" Command="{Binding RefazerExperimentosCommand}" Margin="8,0,0,0"
                                    ToolTip="Apaga as execuções registradas das configurações do plano e treina todas de novo."/>
                            <Button Content="Parar" Command="{Binding PararExperimentosCommand}" Margin="8,0,0,0"
                                    ToolTip="Interrompe após a configuração em andamento — as já concluídas continuam registradas."/>
                        </StackPanel>

                        <TextBlock Text="{Binding CoberturaDoPlano}" FontSize="11" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusExperimentos}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Secondary}"/>

                        <!-- Experimento 1 — varia a camada oculta. -->
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="12" Margin="0,0,0,2">
                            <Run Text="EXPERIMENTO 1 — NEURÔNIOS NA CAMADA OCULTA (4 / 8 / 16)"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="11" FontWeight="Normal" Margin="0,0,0,6" TextWrapping="Wrap">
                            <Run Text="População fixa em"/>
                            <Run Text="{Binding PopulacaoBaseline, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="indivíduos em todas as linhas."/>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding ComparativoCamadaOculta}" Style="{StaticResource TabelaExperimento}" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Neurônios ocultos" Binding="{Binding NeuroniosOcultos}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="População" Binding="{Binding TamanhoPopulacao}" Width="Auto" MinWidth="90"/>
                                <DataGridTextColumn Header="Gerações" Binding="{Binding GeracoesTexto}" Width="Auto" MinWidth="80"/>
                                <DataGridTextColumn Header="Fitness final" Binding="{Binding FitnessFinalTexto}" Width="Auto" MinWidth="100"/>
                                <DataGridTextColumn Header="Tempo total" Binding="{Binding TempoTexto}" Width="Auto" MinWidth="100"/>
                                <DataGridTextColumn Header="Fitness/segundo" Binding="{Binding FitnessPorSegundoTexto}" Width="Auto" MinWidth="110"/>
                                <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHoraTexto}" Width="Auto" MinWidth="140"/>
                                <DataGridTextColumn Header="" Binding="{Binding Destaque}" Width="*" MinWidth="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding ConclusaoCamadaOculta}" FontSize="11" Margin="0,6,0,16" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Secondary}"/>

                        <!-- Experimento 2 — varia a população. -->
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="12" Margin="0,0,0,2">
                            <Run Text="EXPERIMENTO 2 — TAMANHO DA POPULAÇÃO (30 / 60 / 120)"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="11" FontWeight="Normal" Margin="0,0,0,6" TextWrapping="Wrap">
                            <Run Text="Camada oculta fixa em"/>
                            <Run Text="{Binding NeuroniosBaseline, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="neurônios em todas as linhas (a arquitetura usada em produção)."/>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding ComparativoPopulacao}" Style="{StaticResource TabelaExperimento}" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="População" Binding="{Binding TamanhoPopulacao}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="Neurônios ocultos" Binding="{Binding NeuroniosOcultos}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="Gerações" Binding="{Binding GeracoesTexto}" Width="Auto" MinWidth="80"/>
                                <DataGridTextColumn Header="Fitness final" Binding="{Binding FitnessFinalTexto}" Width="Auto" MinWidth="100"/>
                                <DataGridTextColumn Header="Tempo total" Binding="{Binding TempoTexto}" Width="Auto" MinWidth="100"/>
                                <DataGridTextColumn Header="Fitness/segundo" Binding="{Binding FitnessPorSegundoTexto}" Width="Auto" MinWidth="110"/>
                                <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHoraTexto}" Width="Auto" MinWidth="140"/>
                                <DataGridTextColumn Header="" Binding="{Binding Destaque}" Width="*" MinWidth="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding ConclusaoPopulacao}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </StackPanel>
                </Border>

                <!-- Sem dados ainda: nenhum marco completou 500 gerações nesta base. -->
                <Border Style="{StaticResource SemDadosCard}">
                    <TextBlock Text="{Binding MensagemSemDados}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
                </Border>

                <StackPanel Visibility="{Binding TemDados, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <!-- Resumo numérico — coluna vertical (um card embaixo do outro) em vez de
                         lado a lado, para os valores ficarem alinhados e fáceis de comparar. -->
                    <StackPanel Margin="0,0,0,14">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="MARCOS REGISTRADOS" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{Binding Marcos.Count}" Style="{StaticResource CardValue}"/>
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0,8,0,0" FontSize="11">
                                    <Run Text="Último marco: geração "/>
                                    <Run Text="{Binding UltimoMarco.GeracaoMarco, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="FITNESS MÉDIO GERAL" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{Binding FitnessMedioGeral, StringFormat={}{0:0.0}}" Style="{StaticResource CardValue}"/>
                                <TextBlock Text="Média dos fitness médios de todos os blocos de 500 gerações." Style="{StaticResource CardTitle}" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="MELHOR FITNESS JÁ VISTO" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{Binding MelhorFitnessGeral, StringFormat={}{0:0.0}}" Style="{StaticResource CardValue}"/>
                                <TextBlock Text="Pico de melhor fitness entre todos os blocos registrados." Style="{StaticResource CardTitle}" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Gráfico geração a geração (até as últimas 300), mesma fonte e desenho da
                         tela "Treinamento do Controlador" (ver EstatisticasTreinamentoView.xaml.cs) —
                         granularidade fina, complementar ao gráfico por bloco de 500 abaixo. -->
                    <Border Style="{StaticResource Card}" Height="220">
                        <Grid>
                            <TextBlock Text="EVOLUÇÃO DO FITNESS (ÚLTIMAS GERAÇÕES)" Style="{StaticResource CardTitle}" VerticalAlignment="Top"/>
                            <TextBlock Text="— Melhor fitness     ⋯ Fitness médio" VerticalAlignment="Top" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Text.Secondary}" FontSize="11"/>
                            <Canvas x:Name="GraficoGeracaoCanvas" Margin="0,24,0,0">
                                <Polyline x:Name="LinhaMelhorFitnessGeracao" Stroke="{DynamicResource Accent.Fill}" StrokeThickness="2"/>
                                <Polyline x:Name="LinhaFitnessMedioGeracao" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Gráfico: fitness médio do bloco (linha cheia) e melhor fitness do bloco (linha fina) por marco de 500 gerações. -->
                    <Border Style="{StaticResource Card}" Height="260">
                        <Grid>
                            <TextBlock Text="EVOLUÇÃO DO FITNESS POR BLOCO DE 500 GERAÇÕES" Style="{StaticResource CardTitle}" VerticalAlignment="Top"/>
                            <TextBlock Text="— Fitness médio do bloco     ⋯ Melhor fitness do bloco" VerticalAlignment="Top" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Text.Secondary}" FontSize="11"/>
                            <Canvas x:Name="GraficoCanvas" Margin="0,24,0,20">
                                <Polyline x:Name="LinhaFitnessMedio" Stroke="{DynamicResource Accent.Fill}" StrokeThickness="2"/>
                                <Polyline x:Name="LinhaMelhorFitness" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1" StrokeDashArray="3,3"/>
                            </Canvas>
                            <ItemsControl ItemsSource="{Binding Marcos}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GeracaoMarco}" FontSize="10" Width="40" TextAlignment="Center"
                                                   Foreground="{DynamicResource Text.Muted}" FontFamily="{DynamicResource Font.Mono}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Tabela — mesmos estilos de DataGrid usados em "Treinamento do Controlador". -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="MARCOS (TODOS OS REGISTRADOS)" Style="{StaticResource CardTitle}"/>
                            <DataGrid ItemsSource="{Binding Marcos}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" MaxHeight="320"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Background="{DynamicResource Bg.Card}" Foreground="{DynamicResource Text.Primary}"
                                      BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"
                                      RowBackground="{DynamicResource Bg.Card}" AlternatingRowBackground="{DynamicResource Bg.Card}"
                                      HorizontalGridLinesBrush="{DynamicResource Border.Divider}" VerticalGridLinesBrush="{DynamicResource Border.Divider}">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Divider}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Geração" Binding="{Binding GeracaoMarco}" Width="100" MinWidth="80"/>
                                    <DataGridTextColumn Header="Fitness médio do bloco" Binding="{Binding FitnessMedioDoBloco, StringFormat={}{0:0.0}}" Width="1*" MinWidth="140"/>
                                    <DataGridTextColumn Header="Melhor fitness do bloco" Binding="{Binding MelhorFitnessDoBloco, StringFormat={}{0:0.0}}" Width="1*" MinWidth="140"/>
                                    <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="2*" MinWidth="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Histórico comparativo do comportamento do melhor genoma a cada 1.000
                         gerações — nunca sobrescrito (ver IInstantaneoComportamentoRepository):
                         é o que permite estudar caso a caso se a evolução é real (taxa de
                         acerto/cobertura subindo marco a marco) ou só ruído. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="COMPORTAMENTO DO MELHOR GENE (A CADA 1.000 GERAÇÕES)" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="11" FontWeight="Normal" Margin="0,0,0,8" TextWrapping="Wrap"
                                       Text="Retrato completo (decisões/acertos/erros/genoma) de uma geração específica — compare taxa de acerto e cobertura entre marcos para ver se a evolução é real."/>

                            <TextBlock Text="Nenhum instantâneo registrado ainda — o primeiro aparece ao completar a geração 1.000." Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TemInstantaneos}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DataGrid ItemsSource="{Binding Instantaneos}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" MaxHeight="320"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding TemInstantaneos, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Background="{DynamicResource Bg.Card}" Foreground="{DynamicResource Text.Primary}"
                                      BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"
                                      RowBackground="{DynamicResource Bg.Card}" AlternatingRowBackground="{DynamicResource Bg.Card}"
                                      HorizontalGridLinesBrush="{DynamicResource Border.Divider}" VerticalGridLinesBrush="{DynamicResource Border.Divider}">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Divider}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Geração" Binding="{Binding GeracaoMarco}" Width="80" MinWidth="70"/>
                                    <DataGridTextColumn Header="Fitness" Binding="{Binding Fitness, StringFormat={}{0:0.0}}" Width="80" MinWidth="70"/>
                                    <DataGridTextColumn Header="Abatidos" Binding="{Binding AlvosAbatidos}" Width="80" MinWidth="70"/>
                                    <DataGridTextColumn Header="Escapados" Binding="{Binding AlvosEscapados}" Width="80" MinWidth="70"/>
                                    <DataGridTextColumn Header="Tiros errados" Binding="{Binding TirosErrados}" Width="90" MinWidth="80"/>
                                    <DataGridTextColumn Header="Taxa de acerto" Binding="{Binding TaxaDeAcerto, StringFormat={}{0:P0}}" Width="1*" MinWidth="100"/>
                                    <DataGridTextColumn Header="Taxa de cobertura" Binding="{Binding TaxaDeCobertura, StringFormat={}{0:P0}}" Width="1*" MinWidth="100"/>
                                    <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="2*" MinWidth="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
