<UserControl x:Class="RadarTorres.App.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg.Window}"
             Foreground="{DynamicResource Text.Primary}"
             FontFamily="{DynamicResource Font.Body}">
    <!--
        Tela "Usuários" — gerenciamento de contas (nome, e-mail, idade, função/perfil). Somente
        o Administrador enxerga este item de menu (ver ShellViewModel.RebuildMenu +
        PermissionService.PodeVerMenu); a navegação em si é autorizada no NavigationService.

        A tabela ocupava apenas parte da largura porque uma coluna fixa de 320px mantinha dois
        formulários (cadastro/edição e redefinição de senha) SEMPRE visíveis à direita, mesmo sem
        nenhuma operação em andamento. Seguindo a diretriz de UX do projeto, esses formulários
        viraram janelas modais acionadas pelos botões do canto superior direito
        (UsuarioEdicaoWindow e RedefinirSenhaWindow), e a tabela passou a ocupar a tela inteira.
        Nenhuma funcionalidade foi removida: os modais compartilham esta mesma ViewModel e
        disparam os mesmos comandos (NovoCommand, SalvarCommand, RedefinirSenhaCommand).
    -->
    <UserControl.Resources>
        <Style x:Key="AcaoBarra" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource Border.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- A ação principal da tela (criar) recebe a cor de acento; as demais ficam neutras
             para não competirem entre si. -->
        <Style x:Key="AcaoPrincipal" TargetType="Button" BasedOn="{StaticResource AcaoBarra}">
            <Setter Property="Background" Value="{DynamicResource Accent.Fill}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho: título/descrição à esquerda, ações à direita. -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="USUÁRIOS" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource Accent.Fill}" Margin="0,0,0,4"/>
                <TextBlock Text="Contas cadastradas no sistema. Selecione uma linha para editar ou redefinir a senha."
                           Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Ações no canto superior direito. "Editar" e "Redefinir senha" dependem de haver
                 uma linha selecionada; IsEnabled reflete isso para a indisponibilidade ficar
                 visível em vez de o clique simplesmente não fazer nada. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        IsEnabled="{Binding PodeGerenciar}">
                <Button Content="Editar" Style="{StaticResource AcaoBarra}"
                        Click="BotaoEditar_Click"
                        IsEnabled="{Binding TemSelecao}"
                        ToolTip="Abre os dados do usuário selecionado para edição."/>
                <Button Content="Redefinir senha" Style="{StaticResource AcaoBarra}"
                        Click="BotaoRedefinirSenha_Click"
                        IsEnabled="{Binding TemSelecao}"
                        ToolTip="Define uma nova senha para o usuário selecionado, sem precisar da senha atual."/>
                <Button Content="+ Novo usuário" Style="{StaticResource AcaoPrincipal}"
                        Click="BotaoNovo_Click"
                        ToolTip="Cadastra uma nova conta."/>
            </StackPanel>
        </Grid>

        <!-- Tabela em largura total. Duplo clique abre a edição, atalho para quem já selecionou. -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Itens}" SelectedItem="{Binding SelectedUsuario}"
                  MouseDoubleClick="Tabela_MouseDoubleClick"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  Background="{DynamicResource Bg.Card}" Foreground="{DynamicResource Text.Primary}"
                  BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"
                  RowBackground="{DynamicResource Bg.Card}" AlternatingRowBackground="{DynamicResource Bg.Card}"
                  HorizontalGridLinesBrush="{DynamicResource Border.Divider}" VerticalGridLinesBrush="{DynamicResource Border.Divider}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Selection.Subtle}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Divider}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="1.4*" MinWidth="140"/>
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="1.6*" MinWidth="160"/>
                <DataGridTextColumn Header="Idade" Binding="{Binding Idade, TargetNullValue=—}" Width="Auto" MinWidth="60"/>
                <DataGridTextColumn Header="Função" Binding="{Binding Perfil}" Width="Auto" MinWidth="110"/>
                <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="1*" MinWidth="110"/>
                <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="Auto" MinWidth="60"/>
                <DataGridTextColumn Header="Último acesso" Binding="{Binding UltimoAcesso, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue=—}" Width="Auto" MinWidth="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
