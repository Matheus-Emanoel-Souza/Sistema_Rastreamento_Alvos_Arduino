<Window x:Class="RadarTorres.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RadarTorres.App.Localization"
        xmlns:conv="clr-namespace:RadarTorres.App.Converters"
        xmlns:shared="clr-namespace:RadarTorres.App.Views.Shared"
        Title="RadarTorres" Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="32" Width="340">
            <StackPanel>
                <TextBlock Text="RadarTorres" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{loc:Loc Login.Subtitle}" FontSize="11" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,24"/>

                <TextBlock Text="{loc:Loc Login.Username}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="LoginTextBox" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{loc:Loc Login.Password}" Style="{StaticResource FieldLabel}"/>
                <shared:PasswordRevealBox Password="{Binding Senha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                <Button Content="{loc:Loc Login.Submit}" Command="{Binding LoginCommand}"
                        IsDefault="True" Margin="0,20,0,0"/>

                <TextBlock Text="{loc:Loc Login.DefaultAdminHint}" FontSize="10"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
