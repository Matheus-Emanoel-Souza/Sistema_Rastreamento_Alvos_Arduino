<UserControl x:Class="RadarTorres.App.Views.ObjetosDetectadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters"
             Background="{DynamicResource Bg.Window}"
             Foreground="{DynamicResource Text.Primary}"
             FontFamily="Segoe UI">
    <!--
        Tela "Objetos Detectados" (Requisito 4 — histórico de OCORRÊNCIAS de detecção) +
        exportação em CSV/XML/PDF. Cada linha é uma ocorrência: o mesmo alvo cadastrado aparece
        uma vez por quadrante, com a câmera responsável e o estado próprio. É também aqui que o
        operador confirma ou descarta o abate de uma ocorrência deixada pendente por um
        acionamento (ver ObjetosDetectadosViewModel). Sem importação de propósito: as informações desta tabela só podem ser
        geradas pelo próprio sistema rodando (detecção real ou simulada), nunca por um arquivo
        carregado pelo usuário. Substitui o PlaceholderView que existia aqui antes — ver
        NavigationService.
    -->
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource Border.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="OBJETOS DETECTADOS" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Accent.Fill}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Histórico de ocorrências (Requisito 4), geradas pelo próprio sistema — uma por alvo e quadrante. Selecione uma linha para ver o histórico de estados e decidir o abate."
                   Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Exportar:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource Text.Secondary}"/>
            <Button Content="CSV" Command="{Binding ExportCommand}" CommandParameter="csv"/>
            <Button Content="XML" Command="{Binding ExportCommand}" CommandParameter="xml"/>
            <Button Content="PDF" Command="{Binding ExportCommand}" CommandParameter="pdf"/>

            <Rectangle Width="1" Margin="8,2" Fill="{DynamicResource Border.Control}"/>

            <Button Content="Limpar lista" Command="{Binding ClearCommand}" Margin="16,0,0,0"
                    ToolTip="Limpa apenas a lista exibida em tela; os registros continuam salvos no arquivo."/>

            <Rectangle Width="1" Margin="8,2" Fill="{DynamicResource Border.Control}"/>

            <!-- Abate só muda de estado por decisão humana: habilitados apenas quando a
                 ocorrência selecionada está em AbatePendente e o perfil pode executar ações. -->
            <Button Content="Confirmar abate" Command="{Binding ConfirmarAbateCommand}"
                    Background="{DynamicResource Danger.Fill}" Foreground="White"
                    ToolTip="Confirma o abate da ocorrência selecionada (disponível quando há acionamento aguardando confirmação)."/>
            <Button Content="Descartar abate" Command="{Binding DescartarAbateCommand}"
                    ToolTip="Descarta a pendência: a ocorrência volta ao estado Detectado."/>

            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Danger.Fill}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsSuccess}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent.Fill}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Itens}" SelectedItem="{Binding Selecionado}"
                  SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  Background="{DynamicResource Bg.Card}" Foreground="{DynamicResource Text.Primary}"
                  BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"
                  RowBackground="{DynamicResource Bg.Card}" AlternatingRowBackground="{DynamicResource Bg.Card}"
                  HorizontalGridLinesBrush="{DynamicResource Border.Control}" VerticalGridLinesBrush="{DynamicResource Border.Control}">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource Border.Control}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="140"/>
                <DataGridTextColumn Header="X (m)" Binding="{Binding X, StringFormat={}{0:0.00}}" Width="80"/>
                <DataGridTextColumn Header="Y (m)" Binding="{Binding Y, StringFormat={}{0:0.00}}" Width="80"/>
                <DataGridTextColumn Header="Quadrante" Binding="{Binding Quadrante}" Width="90"/>
                <DataGridTextColumn Header="Câmera" Binding="{Binding CameraNome, TargetNullValue=—}" Width="130"/>
                <!-- Id do alvo CADASTRADO que originou a ocorrência (o nome dele está em "Tipo").
                     É este vínculo que sobrevive à edição do cadastro. -->
                <DataGridTextColumn Header="Alvo nº" Binding="{Binding PerfilAlvoId, TargetNullValue=—}" Width="70"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="150"/>
                <DataGridTextColumn Header="Visto por último" Binding="{Binding DataHoraUltimaDeteccao, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}, TargetNullValue=—}" Width="150"/>
                <DataGridTextColumn Header="Dispositivo" Binding="{Binding Dispositivo}" Width="110"/>
                <DataGridTextColumn Header="Confiança" Binding="{Binding NivelConfianca, StringFormat={}{0:0%}, TargetNullValue=—}" Width="90"/>
                <DataGridTextColumn Header="Observação" Binding="{Binding Observacao, TargetNullValue=—}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Histórico de transições da ocorrência selecionada (auditoria do ciclo de abate). -->
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="10" CornerRadius="6"
                Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"
                Visibility="{Binding HistoricoSelecionado, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="HISTÓRICO DE ESTADOS DA OCORRÊNCIA SELECIONADA" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,6"/>
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding HistoricoSelecionado}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Primary}"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
