<Window x:Class="RadarTorres.App.Views.ConfigurarExperimentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar experimento" Height="520" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Font.Body}">

    <!--
        Parâmetros do PRÓXIMO "Iniciar"/"Resetar" do treinamento (população, teto de
        complexidade, mutação estrutural, meta de gerações, eixo Z) —
        antes eram campos inline na barra lateral da tela de Treinamento do Controlador;
        movidos para esta janela modal para liberar espaço útil na tela principal (pedido do
        usuário). Reaproveita a MESMA ViewModel da tela (DataContext setado no code-behind):
        nenhuma lógica nova, nenhum parâmetro renomeado, só uma apresentação diferente das
        mesmas propriedades (TamanhoPopulacao, NeuroniosOcultosSelecionado, TaxaMutacao,
        MetaGeracoes, EixoZHabilitado). Os parâmetros de experimento
        (aqui) continuam separados das heurísticas operacionais, que ficam em Configurações.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="{DynamicResource Border.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <!-- TextBox/ComboBox/ComboBoxItem: estilo global em Styles/Controls.xaml. -->
        <Style x:Key="ParametroLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="CONFIGURAR EXPERIMENTO" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Accent.Fill}"/>
            <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Valem a partir do próximo &quot;Iniciar&quot; ou &quot;Resetar&quot; — não afetam um treinamento já em andamento."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Meta de gerações (0 = sem meta)" Style="{StaticResource ParametroLabel}"/>
                <TextBox Text="{Binding MetaGeracoes, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Com meta definida, a barra de progresso mostra o percentual concluído e o treinamento para sozinho ao alcançá-la. Com 0, o treinamento roda até você mandar parar — o NEAT não tem condição de parada própria nesta aplicação."/>

                <TextBlock Text="Tamanho da população" Style="{StaticResource ParametroLabel}"/>
                <TextBox Text="{Binding TamanhoPopulacao, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Teto de complexidade (conexões)" Style="{StaticResource ParametroLabel}"/>
                <ComboBox ItemsSource="{Binding NeuroniosOcultosDisponiveis}" SelectedItem="{Binding NeuroniosOcultosSelecionado}"
                          ToolTip="Substitui a antiga lista de 'neurônios na camada oculta': com NEAT não se escolhe quantos neurônios a rede tem — escolhe-se até onde ela pode crescer."/>

                <TextBlock Text="Mutação estrutural (0-1)" Style="{StaticResource ParametroLabel}"/>
                <TextBox Text="{Binding TaxaMutacao, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Probabilidade de um descendente ganhar um NEURÔNIO novo. Mutação de peso e mutação de estrutura são eventos distintos; o que sobra é redistribuído entre as outras mutações. Valores do plano experimental: 0,005 · 0,01 (padrão) · 0,02."/>

                <CheckBox Content="Considerar a altura dos alvos (eixo Z)" Margin="0,16,0,0"
                          IsChecked="{Binding EixoZHabilitado}"
                          Foreground="{DynamicResource Text.Primary}" FontSize="12"
                          ToolTip="Vale a partir do próximo &quot;Iniciar&quot;, &quot;Resetar&quot; ou simulação avulsa — um episódio já em curso não muda de dimensão no meio."/>
                <TextBlock Text="{Binding DescricaoEixoZ}" Style="{StaticResource ParametroLabel}"
                           Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"/>

                <CheckBox Content="Bônus por ataque conjunto" Margin="0,16,0,0"
                          IsChecked="{Binding HabilitarBonusAtaqueConjunto}"
                          Foreground="{DynamicResource Text.Primary}" FontSize="12"
                          ToolTip="Soma pontuação extra quando a torre adjacente mais próxima do alvo dispara JUNTO com a torre principal e é esse segundo disparo quem abate o alvo (a principal já havia errado) — recompensa a cooperação, não só o disparo em si."/>

                <CheckBox Content="Permitir troca de alvo por proximidade" Margin="0,12,0,0"
                          IsChecked="{Binding PermitirTrocaDeAlvoPorProximidade}"
                          Foreground="{DynamicResource Text.Primary}" FontSize="12"
                          ToolTip="Uma torre já comprometida com um alvo troca para outro alvo livre se ele estiver mais próximo dela — mesmo que o alvo anterior continue vivo. O alvo abandonado não é descartado: volta a concorrer pela seleção normal (inclusive pela mesma torre, depois)."/>

                <TextBlock Text="Torres desativadas (simula menos recursos)" Style="{StaticResource ParametroLabel}" Margin="0,16,0,0"/>
                <ItemsControl ItemsSource="{Binding TorresConfiguraveis}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Nome}" IsChecked="{Binding Desativada}"
                                      Foreground="{DynamicResource Text.Primary}" FontSize="12" Margin="0,2,0,0"
                                      ToolTip="Torre desativada nunca é selecionada para um alvo nem atua como torre de ajuda — continua fisicamente presente (ainda pode ser invadida), só não participa da defesa."/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource ParametroLabel}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,16,0,0">
                    <Run Text="Alcance de mira e certeza mínima de disparo usados aqui são os mesmos ajustados em "/>
                    <Run Text="Configurações → Controlador" FontWeight="SemiBold"/>
                    <Run Text=" — valem a partir do próximo &quot;Iniciar&quot; ou &quot;Resetar&quot;."/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fechar" IsCancel="True" Click="BotaoFechar_Click"/>
        </StackPanel>
    </Grid>
</Window>
