<Window x:Class="RadarTorres.App.Views.DesempenhoTreinamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desempenho do treinamento" Height="460" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Font.Body}">

    <!--
        Antes era a seção recolhível "4. DESEMPENHO DO TREINAMENTO" na barra lateral da tela de
        Treinamento do Controlador — movida para janela própria (pedido do usuário, mesmo padrão
        já usado em "Experimento e dados" para Configurar experimento/Estatísticas e Análises:
        ver TreinamentoControladorView.BotaoDesempenhoTreinamento_Click). Não-modal, reaproveita a
        MESMA ViewModel da tela (DataContext setado no code-behind) — nenhum dado novo, só outra
        apresentação das mesmas propriedades já existentes (MelhorFitnessDaSessao,
        FitnessMediaMovel, VariacaoNaJanela, GeracoesSemCampeaoNovo, FaseTexto/FaseCor,
        ComplexidadeMedia/Maxima, TetoComplexidadeEmUso). Estilos duplicados aqui (não
        compartilhados via dicionário global) seguindo o mesmo padrão já usado em cada
        View/Window deste projeto (ver EstatisticasTreinamentoView/DesempenhoView).
    -->
    <Window.Resources>
        <Style x:Key="MetricaRotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MetricaValor" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DESEMPENHO DO TREINAMENTO" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource Accent.Fill}" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Melhor da sessão" Style="{StaticResource MetricaRotulo}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricaValor}" Foreground="#4ADE80">
                    <Run Text="{Binding MelhorFitnessDaSessao, StringFormat={}{0:0.0}, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Média móvel (50 gerações)" Style="{StaticResource MetricaRotulo}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FitnessMediaMovel, StringFormat={}{0:0.0}}" Style="{StaticResource MetricaValor}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Variação na janela" Style="{StaticResource MetricaRotulo}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VariacaoNaJanela, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource MetricaValor}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Gerações sem campeão novo" Style="{StaticResource MetricaRotulo}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GeracoesSemCampeaoNovo, StringFormat={}{0:N0}}" Style="{StaticResource MetricaValor}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Fase da evolução" Style="{StaticResource MetricaRotulo}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FaseTexto}" Style="{StaticResource MetricaValor}" Foreground="{Binding FaseCor}" FontWeight="Bold"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Complexidade média / máxima" Style="{StaticResource MetricaRotulo}"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource MetricaValor}">
                    <Run Text="{Binding ComplexidadeMedia, StringFormat={}{0:0.0}, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding ComplexidadeMaxima, StringFormat={}{0:0}, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Teto de complexidade em uso" Style="{StaticResource MetricaRotulo}"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TetoComplexidadeEmUso, StringFormat={}{0:0}}" Style="{StaticResource MetricaValor}"/>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fechar" IsCancel="True" Click="BotaoFechar_Click" Padding="12,7"
                    Background="{DynamicResource Border.Control}" Foreground="{DynamicResource Text.Primary}"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
