<UserControl x:Class="RadarTorres.App.Views.MonitoramentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RadarTorres.App.Views"
             xmlns:shared="clr-namespace:RadarTorres.App.Views.Shared"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters"
             xmlns:models="clr-namespace:RadarTorres.App.Models"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI">
    <!--
        Conteúdo migrado de Views/MainWindow.xaml (era a janela única do app) para um
        UserControl hospedado pela ShellWindow, como parte da introdução da barra lateral de
        navegação. Nenhuma funcionalidade de negócio foi alterada — os 8 painéis que antes
        ficavam fixos em um Grid de 2 colunas (65%/35%) agora são DashboardCard arrastáveis/
        redimensionáveis/ocultáveis dentro de um DashboardCanvas, no mesmo padrão do painel
        principal (Requisito "mesmo padrão de flexibilização... em todas as telas").
    -->

    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter"/>
        <conv:QuadrantToLabelConverter x:Key="QuadrantToLabelConverter"/>
        <conv:SystemModeToLabelConverter x:Key="SystemModeToLabelConverter"/>
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:EnumEqualsToVisibilityConverter x:Key="EnumEqualsToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ações de layout (Requisito 3) — mesmo controle reutilizado no painel principal. -->
        <shared:DashboardToolbar x:Name="Toolbar" Grid.Row="0" Margin="4,4,4,12"/>

        <shared:DashboardCanvas x:Name="LayoutCanvas" Grid.Row="1" ClipToBounds="True">

            <!-- ==================== RADAR ==================== -->
            <shared:DashboardCard x:Name="CardRadar" CardId="Radar" Title="RADAR DE DETECÇÃO"
                                   DefaultWidth="560" DefaultHeight="560"
                                   Canvas.Left="0" Canvas.Top="0" Width="560" Height="560">
                <local:RadarControl Targets="{Binding Targets}"
                                     Towers="{Binding Towers}"
                                     DeadZones="{Binding DeadZones}"
                                     DeadZoneEditMode="{Binding DeadZoneEditMode}"
                                     SelectedTargetId="{Binding SelectedTarget.Id}"
                                     TargetClicked="Radar_TargetClicked"
                                     DeadZoneQuadrantSelected="Radar_DeadZoneQuadrantSelected"
                                     DeadZoneRangeSelected="Radar_DeadZoneRangeSelected"/>
            </shared:DashboardCard>

            <!-- ==================== CONTROLE DO SISTEMA ==================== -->
            <shared:DashboardCard x:Name="CardControleSistema" CardId="ControleSistema" Title="CONTROLE DO SISTEMA"
                                   DefaultWidth="320" DefaultHeight="230"
                                   Canvas.Left="572" Canvas.Top="0" Width="320" Height="230">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Porta COM" Style="{StaticResource LabelText}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"/>
                            <Button Grid.Column="1" Content="⟳" Command="{Binding RefreshPortsCommand}" ToolTip="Atualizar lista de portas"/>
                        </Grid>

                        <TextBlock Text="Baud Rate" Style="{StaticResource LabelText}"/>
                        <ComboBox ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding SelectedBaudRate}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="CONECTAR" Command="{Binding ConnectCommand}" Background="{DynamicResource AccentBrush}"/>
                            <Button Content="DESCONECTAR" Command="{Binding DisconnectCommand}"/>
                            <Ellipse Width="12" Height="12" Margin="10,0,4,0" VerticalAlignment="Center"
                                     Fill="{Binding ConnectionStatus, Converter={StaticResource ConnectionStateToBrushConverter}}"/>
                            <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </shared:DashboardCard>

            <!-- ==================== MODO DE OPERAÇÃO ==================== -->
            <shared:DashboardCard x:Name="CardModoOperacao" CardId="ModoOperacao" Title="MODO DE OPERAÇÃO"
                                   DefaultWidth="320" DefaultHeight="260"
                                   Canvas.Left="904" Canvas.Top="0" Width="320" Height="260">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton GroupName="Mode" Content="1. Sistema desligado"
                                     IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Off}"/>
                        <RadioButton GroupName="Mode" Content="2. Somente localização"
                                     IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LocationOnly}"/>
                        <RadioButton GroupName="Mode" Content="3. Localização + seleção automática de torre"
                                     IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LocationAutoTower}"/>
                        <RadioButton GroupName="Mode" Content="4. Localização + acionamento demonstrativo automático"
                                     IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LocationAutoFire}"/>
                        <RadioButton GroupName="Mode" Content="5. Manutenção"
                                     IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Maintenance}"/>
                        <RadioButton GroupName="Mode" Content="6. Emergência (sistema pausado)"
                                     IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Emergency}"/>
                    </StackPanel>
                </ScrollViewer>
            </shared:DashboardCard>

            <!-- ==================== AÇÕES ==================== -->
            <shared:DashboardCard x:Name="CardAcoes" CardId="Acoes" Title="AÇÕES"
                                   DefaultWidth="320" DefaultHeight="180"
                                   Canvas.Left="572" Canvas.Top="242" Width="320" Height="180">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="ACIONAMENTO MANUAL DEMONSTRATIVO" Command="{Binding ManualFireCommand}" Background="{DynamicResource WarningBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Pausar monitoramento" IsChecked="{Binding IsPaused}" VerticalAlignment="Center" Margin="0,4,16,4"/>
                            <CheckBox Content="Modo de simulação" IsChecked="{Binding IsSimulationMode}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        </StackPanel>
                        <Button Content="LIMPAR RADAR" Command="{Binding ClearRadarCommand}"/>
                        <TextBlock Text="Seu perfil (Visualizador) não permite executar ações."
                                   Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding NaoPodeExecutarAcoes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </shared:DashboardCard>

            <!-- ==================== DISTÂNCIAS ==================== -->
            <shared:DashboardCard x:Name="CardDistancias" CardId="Distancias" Title="DISTÂNCIAS"
                                   DefaultWidth="320" DefaultHeight="130"
                                   Canvas.Left="904" Canvas.Top="272" Width="320" Height="130">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Distância mínima (m)" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding MinDistance, StringFormat={}{0:0.00}, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Distância máxima (m)" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding MaxDistance, StringFormat={}{0:0.00}, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                </Grid>
            </shared:DashboardCard>

            <!-- ==================== SELECIONAR ALVO ==================== -->
            <shared:DashboardCard x:Name="CardSelecionarAlvo" CardId="SelecionarAlvo" Title="SELECIONAR ALVO"
                                   DefaultWidth="320" DefaultHeight="130"
                                   Canvas.Left="572" Canvas.Top="434" Width="320" Height="130">
                <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" VerticalAlignment="Top"/>
            </shared:DashboardCard>

            <!-- ==================== MONITORAMENTO (STATUS) ==================== -->
            <shared:DashboardCard x:Name="CardMonitoramento" CardId="Monitoramento" Title="MONITORAMENTO"
                                   DefaultWidth="520" DefaultHeight="280"
                                   Canvas.Left="0" Canvas.Top="572" Width="520" Height="280">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="STATUS DO SISTEMA" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SystemStatusText}" Style="{StaticResource ValueText}" Foreground="{DynamicResource AccentBrush}"/>

                            <TextBlock Text="MODO" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding CurrentMode, Converter={StaticResource SystemModeToLabelConverter}}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="ALVOS DETECTADOS" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding DetectedTargetsCount}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="ALVO SELECIONADO" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SelectedTarget.Id, StringFormat=#{0:00}, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="QUADRANTE" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SelectedTarget.Quadrant, Converter={StaticResource QuadrantToLabelConverter}}" Style="{StaticResource ValueText}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="POSIÇÃO (X / Y)" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTarget.X, StringFormat='X={0:0.00} m', FallbackValue=—}" Style="{StaticResource ValueText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedTarget.Y, StringFormat='Y={0:0.00} m', FallbackValue=—}" Style="{StaticResource ValueText}"/>
                            </StackPanel>

                            <TextBlock Text="ÂNGULO / DISTÂNCIA DA BASE" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTarget.Angle, StringFormat={}{0:0}°, FallbackValue=—}" Style="{StaticResource ValueText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedTarget.Distance, StringFormat={}{0:0.00} m, FallbackValue=—}" Style="{StaticResource ValueText}"/>
                            </StackPanel>

                            <TextBlock Text="TORRE SELECIONADA / DISTÂNCIA" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTarget.SelectedTower.Name, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource ValueText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedTarget.DistanceToSelectedTower, StringFormat={}{0:0.00} m, FallbackValue=—}" Style="{StaticResource ValueText}"/>
                            </StackPanel>

                            <TextBlock Text="STATUS" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SelectedTargetSafetyStatus}" Style="{StaticResource ValueText}" Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </UniformGrid>
                </ScrollViewer>
            </shared:DashboardCard>

            <!-- ==================== CONSOLE DE EVENTOS ==================== -->
            <shared:DashboardCard x:Name="CardConsoleEventos" CardId="ConsoleEventos" Title="CONSOLE DE EVENTOS"
                                   DefaultWidth="520" DefaultHeight="280"
                                   Canvas.Left="532" Canvas.Top="572" Width="520" Height="280">
                <ListBox ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LogEntry}">
                            <TextBlock Text="{Binding}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </shared:DashboardCard>

            <!-- ==================== ZONAS MORTAS ==================== -->
            <!-- Áreas (quadrante inteiro ou faixa de distância) onde nenhuma torre é selecionada
                 nem acionamento é autorizado — ver TowerSelectionService.SelectTowerFor e
                 FireControlService.Authorize. Criação/remoção restrita ao Administrador
                 (PodeGerenciarZonasMortas); os demais perfis só veem a lista, para saber onde o
                 sistema deliberadamente não vai agir. -->
            <shared:DashboardCard x:Name="CardZonasMortas" CardId="ZonasMortas" Title="ZONAS MORTAS"
                                   DefaultWidth="360" DefaultHeight="420"
                                   Canvas.Left="1064" Canvas.Top="572" Width="360" Height="420">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding DeadZones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DeadZone}">
                                    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      ToolTip="Ativar/desativar esta zona"
                                                      Command="{Binding DataContext.ToggleDeadZoneCommand, RelativeSource={RelativeSource AncestorType=shared:DashboardCard}}"
                                                      CommandParameter="{Binding}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource LabelText}" Margin="0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="✕" Padding="4,0" FontSize="11" ToolTip="Remover zona"
                                                    Command="{Binding DataContext.RemoveDeadZoneCommand, RelativeSource={RelativeSource AncestorType=shared:DashboardCard}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Visibility="{Binding PodeGerenciarZonasMortas, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Nova zona morta — desenhe no radar" Style="{StaticResource LabelText}"/>

                        <CheckBox Content="Selecionar no radar" FontWeight="SemiBold"
                                  IsChecked="{Binding IsDeadZoneDrawingActive}"
                                  ToolTip="Enquanto ligado, clicar/arrastar no radar define zonas em vez de selecionar alvos"/>

                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsDeadZoneDrawingActive}" Margin="0,4,0,4">
                            <RadioButton GroupName="DeadZoneType" Content="Quadrante" Margin="0,0,12,0"
                                         IsChecked="{Binding NewDeadZoneType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Quadrant}"/>
                            <RadioButton GroupName="DeadZoneType" Content="Faixa de distância"
                                         IsChecked="{Binding NewDeadZoneType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DistanceRange}"/>
                        </StackPanel>

                        <TextBox Text="{Binding NewDeadZoneName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome da próxima zona (opcional)"
                                  IsEnabled="{Binding IsDeadZoneDrawingActive}"/>

                        <TextBlock Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Visibility="{Binding IsDeadZoneDrawingActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="Quadrante: clique no radar (clicar de novo remove). Faixa: clique e arraste a partir do centro, solte para confirmar."/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Seu perfil não permite criar ou remover zonas mortas — apenas o Administrador."
                               Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding NaoPodeGerenciarZonasMortas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </shared:DashboardCard>
        </shared:DashboardCanvas>
    </Grid>
</UserControl>
