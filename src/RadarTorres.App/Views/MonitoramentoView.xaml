<UserControl x:Class="RadarTorres.App.Views.MonitoramentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RadarTorres.App.Views"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters"
             xmlns:models="clr-namespace:RadarTorres.App.Models"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI">
    <!--
        Conteúdo migrado de Views/MainWindow.xaml (era a janela única do app) para um
        UserControl hospedado pela ShellWindow, como parte da introdução da barra lateral de
        navegação. Nenhuma funcionalidade foi alterada — só o tipo raiz (Window -> UserControl)
        e as cores de campo de entrada, que agora seguem o tema (DynamicResource) em vez de
        um valor fixo (#1C2530), para funcionar corretamente também no tema claro.
    -->

    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter"/>
        <conv:QuadrantToLabelConverter x:Key="QuadrantToLabelConverter"/>
        <conv:SystemModeToLabelConverter x:Key="SystemModeToLabelConverter"/>
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="35*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LADO ESQUERDO — RADAR ==================== -->
        <Border Grid.Column="0" Margin="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="RADAR DE DETECÇÃO" FontSize="14" FontWeight="Bold" Margin="10,8" Foreground="{DynamicResource AccentBrush}"/>
                <local:RadarControl x:Name="Radar"
                                     Margin="10"
                                     Targets="{Binding Targets}"
                                     Towers="{Binding Towers}"
                                     SelectedTargetId="{Binding SelectedTarget.Id}"
                                     TargetClicked="Radar_TargetClicked"/>
            </DockPanel>
        </Border>

        <!-- ==================== LADO DIREITO ==================== -->
        <Grid Grid.Column="1" Margin="0,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==== PARTE SUPERIOR: CONTROLE DO SISTEMA ==== -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                <StackPanel>
                    <GroupBox Header="CONTROLE DO SISTEMA">
                        <StackPanel>
                            <TextBlock Text="Porta COM" Style="{StaticResource LabelText}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"/>
                                <Button Grid.Column="1" Content="⟳" Command="{Binding RefreshPortsCommand}" ToolTip="Atualizar lista de portas"/>
                            </Grid>

                            <TextBlock Text="Baud Rate" Style="{StaticResource LabelText}"/>
                            <ComboBox ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding SelectedBaudRate}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="CONECTAR" Command="{Binding ConnectCommand}" Background="{DynamicResource AccentBrush}"/>
                                <Button Content="DESCONECTAR" Command="{Binding DisconnectCommand}"/>
                                <Ellipse Width="12" Height="12" Margin="10,0,4,0" VerticalAlignment="Center"
                                         Fill="{Binding ConnectionStatus, Converter={StaticResource ConnectionStateToBrushConverter}}"/>
                                <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="MODO DE OPERAÇÃO">
                        <StackPanel>
                            <RadioButton GroupName="Mode" Content="1. Sistema desligado"
                                         IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Off}"/>
                            <RadioButton GroupName="Mode" Content="2. Somente localização"
                                         IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LocationOnly}"/>
                            <RadioButton GroupName="Mode" Content="3. Localização + seleção automática de torre"
                                         IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LocationAutoTower}"/>
                            <RadioButton GroupName="Mode" Content="4. Localização + acionamento demonstrativo automático"
                                         IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LocationAutoFire}"/>
                            <RadioButton GroupName="Mode" Content="5. Manutenção"
                                         IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Maintenance}"/>
                            <RadioButton GroupName="Mode" Content="6. Emergência (sistema pausado)"
                                         IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Emergency}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="AÇÕES">
                        <StackPanel>
                            <Button Content="ACIONAMENTO MANUAL DEMONSTRATIVO" Command="{Binding ManualFireCommand}" Background="{DynamicResource WarningBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Pausar monitoramento" IsChecked="{Binding IsPaused}" VerticalAlignment="Center" Margin="0,4,16,4"/>
                                <CheckBox Content="Modo de simulação" IsChecked="{Binding IsSimulationMode}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            </StackPanel>
                            <Button Content="LIMPAR RADAR" Command="{Binding ClearRadarCommand}"/>
                            <TextBlock Text="Seu perfil (Visualizador) não permite executar ações."
                                       Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding NaoPodeExecutarAcoes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="DISTÂNCIAS">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Distância mínima (m)" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding MinDistance, StringFormat={}{0:0.00}, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Distância máxima (m)" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding MaxDistance, StringFormat={}{0:0.00}, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="SELECIONAR ALVO">
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== PARTE INFERIOR: MONITORAMENTO E LOGS ==== -->
            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="MONITORAMENTO">
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="STATUS DO SISTEMA" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SystemStatusText}" Style="{StaticResource ValueText}" Foreground="{DynamicResource AccentBrush}"/>

                            <TextBlock Text="MODO" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding CurrentMode, Converter={StaticResource SystemModeToLabelConverter}}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="ALVOS DETECTADOS" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding DetectedTargetsCount}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="ALVO SELECIONADO" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SelectedTarget.Id, StringFormat=#{0:00}, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="QUADRANTE" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SelectedTarget.Quadrant, Converter={StaticResource QuadrantToLabelConverter}}" Style="{StaticResource ValueText}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="POSIÇÃO (X / Y)" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTarget.X, StringFormat='X={0:0.00} m', FallbackValue=—}" Style="{StaticResource ValueText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedTarget.Y, StringFormat='Y={0:0.00} m', FallbackValue=—}" Style="{StaticResource ValueText}"/>
                            </StackPanel>

                            <TextBlock Text="ÂNGULO / DISTÂNCIA DA BASE" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTarget.Angle, StringFormat={}{0:0}°, FallbackValue=—}" Style="{StaticResource ValueText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedTarget.Distance, StringFormat={}{0:0.00} m, FallbackValue=—}" Style="{StaticResource ValueText}"/>
                            </StackPanel>

                            <TextBlock Text="TORRE SELECIONADA / DISTÂNCIA" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTarget.SelectedTower.Name, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource ValueText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedTarget.DistanceToSelectedTower, StringFormat={}{0:0.00} m, FallbackValue=—}" Style="{StaticResource ValueText}"/>
                            </StackPanel>

                            <TextBlock Text="STATUS" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SelectedTargetSafetyStatus}" Style="{StaticResource ValueText}" Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </UniformGrid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="CONSOLE DE EVENTOS">
                    <ListBox x:Name="EventLogListBox" ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LogEntry}">
                                <TextBlock Text="{Binding}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
