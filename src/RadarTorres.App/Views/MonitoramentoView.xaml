<UserControl x:Class="RadarTorres.App.Views.MonitoramentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RadarTorres.App.Views"
             xmlns:shared="clr-namespace:RadarTorres.App.Views.Shared"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters"
             xmlns:models="clr-namespace:RadarTorres.App.Models"
             xmlns:loc="clr-namespace:RadarTorres.App.Localization"
             Background="{DynamicResource Bg.Window}"
             Foreground="{DynamicResource Text.Primary}"
             FontFamily="Segoe UI">
    <!--
        Conteúdo migrado de Views/MainWindow.xaml (era a janela única do app) para um
        UserControl hospedado pela ShellWindow, como parte da introdução da barra lateral de
        navegação. Nenhuma funcionalidade de negócio foi alterada — os 8 painéis que antes
        ficavam fixos em um Grid de 2 colunas (65%/35%) agora são DashboardCard arrastáveis/
        redimensionáveis/ocultáveis dentro de um DashboardCanvas, no mesmo padrão do painel
        principal (Requisito "mesmo padrão de flexibilização... em todas as telas").
    -->

    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <conv:QuadrantToLabelConverter x:Key="QuadrantToLabelConverter"/>
        <conv:SystemModeToLabelConverter x:Key="SystemModeToLabelConverter"/>
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:EnumEqualsToVisibilityConverter x:Key="EnumEqualsToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/>
        </Style>
        <!-- Rótulos em maiúsculas (Requisito "grade 2x2... rótulos em maiúsculas 12px"). -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <!-- Valores numéricos/dados (Requisito "mono 20px peso 500"). -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="{DynamicResource Border.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Botão de modo (Requisito "três botões... altura 52px, cantos 12px, borda 2px"). -->
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" CornerRadius="12">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Tag}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,4,4,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Ações de layout (Requisito 3) — mesmo controle reutilizado no painel principal. -->
            <shared:DashboardToolbar x:Name="Toolbar" Grid.Column="0" Margin="0"/>

            <!-- Fixa/solta o Console de Eventos na faixa lateral direita (fora do canvas
                 arrastável) — só este card, ver MonitoramentoView.SetLogPinned. -->
            <ToggleButton x:Name="PinLogToggle" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                          Padding="12,8" Cursor="Hand" BorderThickness="1" MinHeight="36"
                          FontFamily="{DynamicResource Font.Body}" FontSize="14"
                          Checked="PinLogToggle_Checked" Unchecked="PinLogToggle_Unchecked"
                          Content="Fixar logs na lateral"
                          ToolTip="Fixa o Console de Eventos numa faixa na borda direita da tela, fora do arraste">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Accent.Fill}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PinnedLogColumn" Width="0"/>
            </Grid.ColumnDefinitions>

        <!-- Scroll vertical modesto: o canvas de cards (radar + painéis) passa de ~1000px de
             altura no arranjo padrão, mais do que cabe em telas menores — em vez de comprimir os
             cards verticalmente a cada redimensionamento (como antes), o canvas agora tem uma
             altura mínima fixa e o ScrollViewer deixa rolar até o fim quando a janela for mais
             baixa que isso. Sem scroll horizontal — a largura continua acompanhando a janela. -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <shared:DashboardCanvas x:Name="LayoutCanvas" MinHeight="1020" ClipToBounds="True">

            <!-- ==================== RADAR ==================== -->
            <shared:DashboardCard x:Name="CardRadar" CardId="Radar" Title="RADAR DE DETECÇÃO"
                                   DefaultWidth="560" DefaultHeight="596"
                                   Canvas.Left="0" Canvas.Top="0" Width="560" Height="596">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <local:RadarControl Grid.Row="0" Targets="{Binding Targets}"
                                         Towers="{Binding Towers}"
                                         ZonaMortas="{Binding ZonaMortas}"
                                         ZonaMortaEditMode="{Binding ZonaMortaEditMode}"
                                         SelectedTargetId="{Binding SelectedTarget.Id}"
                                         TargetClicked="Radar_TargetClicked"
                                         ZonaMortaQuadrantSelected="Radar_ZonaMortaQuadrantSelected"
                                         ZonaMortaRangeSelected="Radar_ZonaMortaRangeSelected"/>

                    <!-- Legenda (Requisito "legenda com três itens"). -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Rectangle Width="10" Height="10" Fill="{DynamicResource Target.Fill}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc Monitoramento.Legenda.Alvo}" Style="{StaticResource LabelText}" Margin="0" FontFamily="{DynamicResource Font.Body}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Rectangle Width="10" Height="10" Stroke="{DynamicResource Accent.Fill}" StrokeThickness="2" Fill="Transparent" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc Monitoramento.Legenda.Torre}" Style="{StaticResource LabelText}" Margin="0" FontFamily="{DynamicResource Font.Body}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="10" Height="10" Fill="{DynamicResource Accent.Fill}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc Monitoramento.Legenda.TorreSelecionada}" Style="{StaticResource LabelText}" Margin="0" FontFamily="{DynamicResource Font.Body}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </shared:DashboardCard>

            <!-- ==================== MODO DE OPERAÇÃO ==================== -->
            <!-- Só 3 modos, estilo semáforo (Requisito): Verde=Ligado apenas, Amarelo=Acompanhar
                 alvos, Vermelho=Disparar (ver Models/SystemState.cs). Só lista como opção de
                 troca os modos que NÃO são o atual — MainViewModel.OutrosModos recalcula a lista
                 toda vez que CurrentMode muda. Cada botão passa o SystemMode clicado como
                 CommandParameter para SetModeCommand, que reaproveita a mesma confirmação e
                 auditoria (modo_atual_torre) já existentes no setter de CurrentMode. As cores
                 (Accent.Fill/Target.Fill/Danger.Fill) são as mesmas já usadas no resto do app
                 para verde/amarelo/vermelho — trocam automaticamente com o tema. -->
            <shared:DashboardCard x:Name="CardModoOperacao" CardId="ModoOperacao" Title="MODO DE OPERAÇÃO"
                                   DefaultWidth="320" DefaultHeight="260"
                                   Canvas.Left="904" Canvas.Top="0" Width="320" Height="260">
                <!--
                    3 botões sempre visíveis (Requisito), um por SystemMode — troca a mesma
                    SetModeCommand/CurrentMode de sempre (inclusive a confirmação já existente em
                    MainViewModel.CurrentMode, que vira só um "return" sem diálogo quando o modo
                    clicado já é o atual). O selo "ATIVO" aparece no botão do modo corrente; o
                    selo "pede confirmação" é só informativo no botão Vermelho — a confirmação em
                    si já existe e não muda aqui.
                -->
                <StackPanel>
                    <!-- Verde — Ligado apenas. -->
                    <Button Content="{x:Static models:SystemMode.LigadoApenas}"
                            Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:SystemMode.LigadoApenas}">
                        <Button.ContentTemplate>
                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource SystemModeToLabelConverter}}" TextWrapping="Wrap"/></DataTemplate>
                        </Button.ContentTemplate>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent.Text}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static models:SystemMode.LigadoApenas}">
                                        <Setter Property="Background" Value="{DynamicResource Accent.Fill}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                        <Setter Property="Tag">
                                            <Setter.Value>
                                                <TextBlock Text="ATIVO" FontFamily="{DynamicResource Font.Mono}" FontSize="12" Foreground="{DynamicResource OnAccent}"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Amarelo — Acompanhar alvos. -->
                    <Button Content="{x:Static models:SystemMode.AcompanharAlvos}"
                            Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:SystemMode.AcompanharAlvos}">
                        <Button.ContentTemplate>
                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource SystemModeToLabelConverter}}" TextWrapping="Wrap"/></DataTemplate>
                        </Button.ContentTemplate>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Target.Fill}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Warning.Text}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static models:SystemMode.AcompanharAlvos}">
                                        <Setter Property="Background" Value="{DynamicResource Target.Fill}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                        <Setter Property="Tag">
                                            <Setter.Value>
                                                <TextBlock Text="ATIVO" FontFamily="{DynamicResource Font.Mono}" FontSize="12" Foreground="{DynamicResource OnAccent}"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Vermelho — Disparar. -->
                    <Button Content="{x:Static models:SystemMode.Disparar}"
                            Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:SystemMode.Disparar}">
                        <Button.ContentTemplate>
                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource SystemModeToLabelConverter}}" TextWrapping="Wrap"/></DataTemplate>
                        </Button.ContentTemplate>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Danger.Fill}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Danger.Text}"/>
                                <Setter Property="Tag">
                                    <Setter.Value>
                                        <TextBlock Text="pede confirmação" FontFamily="{DynamicResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static models:SystemMode.Disparar}">
                                        <Setter Property="Background" Value="{DynamicResource Danger.Fill}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                        <Setter Property="Tag">
                                            <Setter.Value>
                                                <TextBlock Text="ATIVO" FontFamily="{DynamicResource Font.Mono}" FontSize="12" Foreground="{DynamicResource OnAccent}"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </shared:DashboardCard>

            <!-- ==================== DETECÇÃO POR CÂMERA ==================== -->
            <!-- Vídeo em tempo real de uma câmera com detecção por visão computacional (YOLO)
                 sobre o perfil de alvo ativo (Services/AlvoVisualService) — enquanto o modo de
                 operação é Amarelo/Vermelho, um alvo identificado dispara alerta sonoro/por voz
                 com a distância estimada (ver DeteccaoCameraViewModel). DataContext próprio
                 (DeteccaoCameraViewModel, não MainViewModel) porque é um componente
                 autocontido, mesmo padrão de CameraSlotViewModel dentro de CamerasViewModel. -->
            <shared:DashboardCard x:Name="CardDeteccaoCamera" CardId="DeteccaoCamera" Title="DETECÇÃO POR CÂMERA"
                                   DefaultWidth="320" DefaultHeight="340"
                                   Canvas.Left="904" Canvas.Top="272" Width="320" Height="340">
                <!--
                    Layout responsivo ao tamanho do card (o usuário redimensiona livremente, ver
                    DashboardCard): Grid em vez de StackPanel, com o VÍDEO na única linha "*" —
                    assim ele ocupa a altura que sobrar e encolhe junto com o card, em vez de ter
                    altura fixa e ser cortado. Stretch="Uniform" preserva a proporção original da
                    imagem em qualquer tamanho (sem distorção), e os blocos de texto abaixo ficam
                    num ScrollViewer vertical para permanecerem alcançáveis quando o card for
                    muito baixo — sem nunca produzir rolagem horizontal (todos os textos usam
                    TextWrapping, e nada tem largura fixa).
                -->
                <Grid DataContext="{Binding DeteccaoCamera}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="70"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ComboBox Grid.Row="0" ItemsSource="{Binding AvailableCameras}" SelectedItem="{Binding SelectedCamera}"
                              DisplayMemberPath="Name" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>

                    <!-- Quadrante da câmera escolhida: é nele que as ocorrências desta câmera são
                         registradas (atribuição feita na tela "Câmeras"). -->
                    <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6">
                        <Run Text="Quadrante da câmera:"/><Run Text=" "/><Run Text="{Binding QuadranteDaCamera, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>

                    <Grid Grid.Row="2" Margin="0,0,0,8" MinHeight="150">
                        <!-- Sem câmera: fundo Bg.Window + borda tracejada + texto central
                             (Requisito). Com câmera: a imagem cobre este placeholder. -->
                        <Grid>
                            <Rectangle RadiusX="10" RadiusY="10" Fill="{DynamicResource Bg.Window}"
                                       Stroke="{DynamicResource Border.Control}" StrokeThickness="1" StrokeDashArray="4,3"/>
                            <TextBlock Text="{loc:Loc Monitoramento.SelecioneUmaCamera}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource Font.Body}" FontSize="13" Foreground="{DynamicResource Text.Neutral}"/>
                        </Grid>

                        <Border CornerRadius="10" ClipToBounds="True"
                                Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Source="{Binding CurrentFrame}" Stretch="Uniform" StretchDirection="Both"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="150">
                        <StackPanel>
                            <!-- Contorno das regiões avaliadas desenhado sobre o vídeo: deixa visível o
                                 que o sistema está considerando além do alvo pretendido (ver
                                 DeteccaoCameraViewModel.DesenharCaixas). -->
                            <CheckBox IsChecked="{Binding MostrarCaixasDeteccao}" Content="Marcar o que foi detectado"
                                      Foreground="{DynamicResource ForegroundBrush}" FontSize="11" Margin="0,0,0,2"/>

                            <TextBlock Style="{StaticResource LabelText}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Visibility="{Binding MostrarCaixasDeteccao, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="■" Foreground="Lime"/><Run Text=" alvo  "/><Run Text="■" Foreground="#FF3C3C"/><Run Text=" objeto recusado  "/><Run Text="■" Foreground="#FFD200"/><Run Text=" cor recusada"/>
                            </TextBlock>

                            <TextBlock Text="{Binding StatusDeteccao}" Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                            <TextBlock Text="{Binding UltimaDistanciaMetros, StringFormat='Distância: {0:0.0} m'}"
                                       FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Danger.Fill}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding UltimaDistanciaMetros, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </shared:DashboardCard>

            <!-- ==================== MONITORAMENTO (STATUS) ==================== -->
            <shared:DashboardCard x:Name="CardMonitoramento" CardId="Monitoramento" Title="MONITORAMENTO"
                                   DefaultWidth="520" DefaultHeight="280"
                                   Canvas.Left="0" Canvas.Top="572" Width="520" Height="280">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="STATUS DO SISTEMA" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SystemStatusText}" Style="{StaticResource ValueText}" Foreground="{DynamicResource Accent.Fill}"/>

                            <TextBlock Text="MODO" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding CurrentMode, Converter={StaticResource SystemModeToLabelConverter}}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="ALVOS DETECTADOS" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding DetectedTargetsCount}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="ALVO SELECIONADO" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SelectedTarget.Id, StringFormat=#{0:00}, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="QUADRANTE" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SelectedTarget.Quadrant, Converter={StaticResource QuadrantToLabelConverter}}" Style="{StaticResource ValueText}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="POSIÇÃO (X / Y)" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTarget.X, StringFormat='X={0:0.00} m', FallbackValue=—}" Style="{StaticResource ValueText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedTarget.Y, StringFormat='Y={0:0.00} m', FallbackValue=—}" Style="{StaticResource ValueText}"/>
                            </StackPanel>

                            <TextBlock Text="ÂNGULO / DISTÂNCIA DA BASE" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTarget.Angle, StringFormat={}{0:0}°, FallbackValue=—}" Style="{StaticResource ValueText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedTarget.Distance, StringFormat={}{0:0.00} m, FallbackValue=—}" Style="{StaticResource ValueText}"/>
                            </StackPanel>

                            <TextBlock Text="TORRE SELECIONADA / DISTÂNCIA" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTarget.SelectedTower.Name, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource ValueText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedTarget.DistanceToSelectedTower, StringFormat={}{0:0.00} m, FallbackValue=—}" Style="{StaticResource ValueText}"/>
                            </StackPanel>

                            <TextBlock Text="STATUS" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SelectedTargetSafetyStatus}" Style="{StaticResource ValueText}" Foreground="{DynamicResource Target.Fill}"/>
                        </StackPanel>
                    </UniformGrid>
                </ScrollViewer>
            </shared:DashboardCard>

            <!-- ==================== CONSOLE DE EVENTOS ==================== -->
            <shared:DashboardCard x:Name="CardConsoleEventos" CardId="ConsoleEventos" Title="CONSOLE DE EVENTOS"
                                   DefaultWidth="520" DefaultHeight="280"
                                   Canvas.Left="532" Canvas.Top="572" Width="520" Height="280">
                <ListBox ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LogEntry}">
                            <TextBlock Text="{Binding}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </shared:DashboardCard>

            <!-- ==================== ZONAS MORTAS ==================== -->
            <!-- Áreas (quadrante inteiro ou faixa de distância) onde nenhuma torre é selecionada
                 nem acionamento é autorizado — ver TowerSelectionService.SelectTowerFor e
                 FireControlService.Authorize. Criação/remoção restrita ao Administrador
                 (PodeGerenciarZonasMortas); os demais perfis só veem a lista, para saber onde o
                 sistema deliberadamente não vai agir. -->
            <shared:DashboardCard x:Name="CardZonasMortas" CardId="ZonasMortas" Title="ZONAS MORTAS"
                                   DefaultWidth="360" DefaultHeight="420"
                                   Canvas.Left="1064" Canvas.Top="572" Width="360" Height="420">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding ZonaMortas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ZonaMorta}">
                                    <Border BorderBrush="{DynamicResource Border.Control}" BorderThickness="0,0,0,1" Padding="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      ToolTip="Ativar/desativar esta zona"
                                                      Command="{Binding DataContext.ToggleZonaMortaCommand, RelativeSource={RelativeSource AncestorType=shared:DashboardCard}}"
                                                      CommandParameter="{Binding}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource LabelText}" Margin="0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="✕" Padding="4,0" FontSize="11" ToolTip="Remover zona"
                                                    Command="{Binding DataContext.RemoveZonaMortaCommand, RelativeSource={RelativeSource AncestorType=shared:DashboardCard}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Visibility="{Binding PodeGerenciarZonasMortas, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Nova zona morta — desenhe no radar" Style="{StaticResource LabelText}"/>

                        <CheckBox Content="Selecionar no radar" FontWeight="SemiBold"
                                  IsChecked="{Binding IsZonaMortaDrawingActive}"
                                  ToolTip="Enquanto ligado, clicar/arrastar no radar define zonas em vez de selecionar alvos"/>

                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsZonaMortaDrawingActive}" Margin="0,4,0,4">
                            <RadioButton GroupName="ZonaMortaType" Content="Quadrante" Margin="0,0,12,0"
                                         IsChecked="{Binding NewZonaMortaType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Quadrant}"/>
                            <RadioButton GroupName="ZonaMortaType" Content="Faixa de distância"
                                         IsChecked="{Binding NewZonaMortaType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DistanceRange}"/>
                        </StackPanel>

                        <TextBox Text="{Binding NewZonaMortaName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome da próxima zona (opcional)"
                                  IsEnabled="{Binding IsZonaMortaDrawingActive}"/>

                        <TextBlock Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Visibility="{Binding IsZonaMortaDrawingActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="Quadrante: clique no radar (clicar de novo remove). Faixa: clique e arraste a partir do centro, solte para confirmar."/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Seu perfil não permite criar ou remover zonas mortas — apenas o Administrador."
                               Foreground="{DynamicResource Target.Fill}" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding NaoPodeGerenciarZonasMortas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </shared:DashboardCard>
        </shared:DashboardCanvas>
        </ScrollViewer>

            <!-- Faixa encaixada na borda direita — só existe/aparece enquanto PinLogToggle
                 estiver marcado; o conteúdo (ListBox de LogEntries) é o mesmo controle
                 realocado de dentro de CardConsoleEventos, nunca uma cópia (ver
                 MonitoramentoView.SetLogPinned). -->
            <Border x:Name="PinnedLogPanel" Grid.Column="1" Margin="8,0,0,0" Visibility="Collapsed"
                    Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Control}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="CONSOLE DE EVENTOS" Margin="12,10,12,6"
                               Foreground="{DynamicResource Text.Secondary}" FontSize="12" FontWeight="SemiBold"/>
                    <ContentControl x:Name="PinnedLogHost" Grid.Row="1" Margin="12,0,12,12"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
