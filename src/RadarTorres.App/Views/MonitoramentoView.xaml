<UserControl x:Class="RadarTorres.App.Views.MonitoramentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RadarTorres.App.Views"
             xmlns:shared="clr-namespace:RadarTorres.App.Views.Shared"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters"
             xmlns:models="clr-namespace:RadarTorres.App.Models"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI">
    <!--
        Conteúdo migrado de Views/MainWindow.xaml (era a janela única do app) para um
        UserControl hospedado pela ShellWindow, como parte da introdução da barra lateral de
        navegação. Nenhuma funcionalidade de negócio foi alterada — os 8 painéis que antes
        ficavam fixos em um Grid de 2 colunas (65%/35%) agora são DashboardCard arrastáveis/
        redimensionáveis/ocultáveis dentro de um DashboardCanvas, no mesmo padrão do painel
        principal (Requisito "mesmo padrão de flexibilização... em todas as telas").
    -->

    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <conv:QuadrantToLabelConverter x:Key="QuadrantToLabelConverter"/>
        <conv:SystemModeToLabelConverter x:Key="SystemModeToLabelConverter"/>
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:EnumEqualsToVisibilityConverter x:Key="EnumEqualsToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,4,4,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Ações de layout (Requisito 3) — mesmo controle reutilizado no painel principal. -->
            <shared:DashboardToolbar x:Name="Toolbar" Grid.Column="0" Margin="0"/>

            <!-- Fixa/solta o Console de Eventos na faixa lateral direita (fora do canvas
                 arrastável) — só este card, ver MonitoramentoView.SetLogPinned. -->
            <ToggleButton x:Name="PinLogToggle" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                          Padding="8,4" Cursor="Hand" BorderThickness="0"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Checked="PinLogToggle_Checked" Unchecked="PinLogToggle_Unchecked"
                          Content="📌 Fixar logs na lateral"
                          ToolTip="Fixa o Console de Eventos numa faixa na borda direita da tela, fora do arraste">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PinnedLogColumn" Width="0"/>
            </Grid.ColumnDefinitions>

        <!-- Scroll vertical modesto: o canvas de cards (radar + painéis) passa de ~1000px de
             altura no arranjo padrão, mais do que cabe em telas menores — em vez de comprimir os
             cards verticalmente a cada redimensionamento (como antes), o canvas agora tem uma
             altura mínima fixa e o ScrollViewer deixa rolar até o fim quando a janela for mais
             baixa que isso. Sem scroll horizontal — a largura continua acompanhando a janela. -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <shared:DashboardCanvas x:Name="LayoutCanvas" MinHeight="1020" ClipToBounds="True">

            <!-- ==================== RADAR ==================== -->
            <shared:DashboardCard x:Name="CardRadar" CardId="Radar" Title="RADAR DE DETECÇÃO"
                                   DefaultWidth="560" DefaultHeight="560"
                                   Canvas.Left="0" Canvas.Top="0" Width="560" Height="560">
                <local:RadarControl Targets="{Binding Targets}"
                                     Towers="{Binding Towers}"
                                     ZonaMortas="{Binding ZonaMortas}"
                                     ZonaMortaEditMode="{Binding ZonaMortaEditMode}"
                                     SelectedTargetId="{Binding SelectedTarget.Id}"
                                     TargetClicked="Radar_TargetClicked"
                                     ZonaMortaQuadrantSelected="Radar_ZonaMortaQuadrantSelected"
                                     ZonaMortaRangeSelected="Radar_ZonaMortaRangeSelected"/>
            </shared:DashboardCard>

            <!-- ==================== MODO DE OPERAÇÃO ==================== -->
            <!-- Só 3 modos, estilo semáforo (Requisito): Verde=Ligado apenas, Amarelo=Acompanhar
                 alvos, Vermelho=Disparar (ver Models/SystemState.cs). Só lista como opção de
                 troca os modos que NÃO são o atual — MainViewModel.OutrosModos recalcula a lista
                 toda vez que CurrentMode muda. Cada botão passa o SystemMode clicado como
                 CommandParameter para SetModeCommand, que reaproveita a mesma confirmação e
                 auditoria (modo_atual_torre) já existentes no setter de CurrentMode. As cores
                 (AccentBrush/WarningBrush/DangerBrush) são as mesmas já usadas no resto do app
                 para verde/amarelo/vermelho — trocam automaticamente com o tema. -->
            <shared:DashboardCard x:Name="CardModoOperacao" CardId="ModoOperacao" Title="MODO DE OPERAÇÃO"
                                   DefaultWidth="320" DefaultHeight="260"
                                   Canvas.Left="904" Canvas.Top="0" Width="320" Height="260">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MODO ATUAL" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding CurrentMode, Converter={StaticResource SystemModeToLabelConverter}}"
                                   Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static models:SystemMode.AcompanharAlvos}">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static models:SystemMode.Disparar}">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="MUDAR PARA" Style="{StaticResource LabelText}"/>
                        <ItemsControl ItemsSource="{Binding OutrosModos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Converter={StaticResource SystemModeToLabelConverter}}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Foreground="White"
                                            Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=shared:DashboardCard}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static models:SystemMode.AcompanharAlvos}">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static models:SystemMode.Disparar}">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </shared:DashboardCard>

            <!-- ==================== DISTÂNCIAS ==================== -->
            <shared:DashboardCard x:Name="CardDistancias" CardId="Distancias" Title="DISTÂNCIAS"
                                   DefaultWidth="320" DefaultHeight="130"
                                   Canvas.Left="904" Canvas.Top="272" Width="320" Height="130">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Distância mínima (m)" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding MinDistance, StringFormat={}{0:0.00}, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Distância máxima (m)" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding MaxDistance, StringFormat={}{0:0.00}, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                </Grid>
            </shared:DashboardCard>

            <!-- ==================== MONITORAMENTO (STATUS) ==================== -->
            <shared:DashboardCard x:Name="CardMonitoramento" CardId="Monitoramento" Title="MONITORAMENTO"
                                   DefaultWidth="520" DefaultHeight="280"
                                   Canvas.Left="0" Canvas.Top="572" Width="520" Height="280">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="STATUS DO SISTEMA" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SystemStatusText}" Style="{StaticResource ValueText}" Foreground="{DynamicResource AccentBrush}"/>

                            <TextBlock Text="MODO" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding CurrentMode, Converter={StaticResource SystemModeToLabelConverter}}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="ALVOS DETECTADOS" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding DetectedTargetsCount}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="ALVO SELECIONADO" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SelectedTarget.Id, StringFormat=#{0:00}, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="QUADRANTE" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SelectedTarget.Quadrant, Converter={StaticResource QuadrantToLabelConverter}}" Style="{StaticResource ValueText}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="POSIÇÃO (X / Y)" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTarget.X, StringFormat='X={0:0.00} m', FallbackValue=—}" Style="{StaticResource ValueText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedTarget.Y, StringFormat='Y={0:0.00} m', FallbackValue=—}" Style="{StaticResource ValueText}"/>
                            </StackPanel>

                            <TextBlock Text="ÂNGULO / DISTÂNCIA DA BASE" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTarget.Angle, StringFormat={}{0:0}°, FallbackValue=—}" Style="{StaticResource ValueText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedTarget.Distance, StringFormat={}{0:0.00} m, FallbackValue=—}" Style="{StaticResource ValueText}"/>
                            </StackPanel>

                            <TextBlock Text="TORRE SELECIONADA / DISTÂNCIA" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTarget.SelectedTower.Name, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource ValueText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedTarget.DistanceToSelectedTower, StringFormat={}{0:0.00} m, FallbackValue=—}" Style="{StaticResource ValueText}"/>
                            </StackPanel>

                            <TextBlock Text="STATUS" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding SelectedTargetSafetyStatus}" Style="{StaticResource ValueText}" Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </UniformGrid>
                </ScrollViewer>
            </shared:DashboardCard>

            <!-- ==================== CONSOLE DE EVENTOS ==================== -->
            <shared:DashboardCard x:Name="CardConsoleEventos" CardId="ConsoleEventos" Title="CONSOLE DE EVENTOS"
                                   DefaultWidth="520" DefaultHeight="280"
                                   Canvas.Left="532" Canvas.Top="572" Width="520" Height="280">
                <ListBox ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LogEntry}">
                            <TextBlock Text="{Binding}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </shared:DashboardCard>

            <!-- ==================== ZONAS MORTAS ==================== -->
            <!-- Áreas (quadrante inteiro ou faixa de distância) onde nenhuma torre é selecionada
                 nem acionamento é autorizado — ver TowerSelectionService.SelectTowerFor e
                 FireControlService.Authorize. Criação/remoção restrita ao Administrador
                 (PodeGerenciarZonasMortas); os demais perfis só veem a lista, para saber onde o
                 sistema deliberadamente não vai agir. -->
            <shared:DashboardCard x:Name="CardZonasMortas" CardId="ZonasMortas" Title="ZONAS MORTAS"
                                   DefaultWidth="360" DefaultHeight="420"
                                   Canvas.Left="1064" Canvas.Top="572" Width="360" Height="420">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding ZonaMortas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ZonaMorta}">
                                    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      ToolTip="Ativar/desativar esta zona"
                                                      Command="{Binding DataContext.ToggleZonaMortaCommand, RelativeSource={RelativeSource AncestorType=shared:DashboardCard}}"
                                                      CommandParameter="{Binding}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource LabelText}" Margin="0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="✕" Padding="4,0" FontSize="11" ToolTip="Remover zona"
                                                    Command="{Binding DataContext.RemoveZonaMortaCommand, RelativeSource={RelativeSource AncestorType=shared:DashboardCard}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Visibility="{Binding PodeGerenciarZonasMortas, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Nova zona morta — desenhe no radar" Style="{StaticResource LabelText}"/>

                        <CheckBox Content="Selecionar no radar" FontWeight="SemiBold"
                                  IsChecked="{Binding IsZonaMortaDrawingActive}"
                                  ToolTip="Enquanto ligado, clicar/arrastar no radar define zonas em vez de selecionar alvos"/>

                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsZonaMortaDrawingActive}" Margin="0,4,0,4">
                            <RadioButton GroupName="ZonaMortaType" Content="Quadrante" Margin="0,0,12,0"
                                         IsChecked="{Binding NewZonaMortaType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Quadrant}"/>
                            <RadioButton GroupName="ZonaMortaType" Content="Faixa de distância"
                                         IsChecked="{Binding NewZonaMortaType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DistanceRange}"/>
                        </StackPanel>

                        <TextBox Text="{Binding NewZonaMortaName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome da próxima zona (opcional)"
                                  IsEnabled="{Binding IsZonaMortaDrawingActive}"/>

                        <TextBlock Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Visibility="{Binding IsZonaMortaDrawingActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="Quadrante: clique no radar (clicar de novo remove). Faixa: clique e arraste a partir do centro, solte para confirmar."/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Seu perfil não permite criar ou remover zonas mortas — apenas o Administrador."
                               Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding NaoPodeGerenciarZonasMortas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </shared:DashboardCard>
        </shared:DashboardCanvas>
        </ScrollViewer>

            <!-- Faixa encaixada na borda direita — só existe/aparece enquanto PinLogToggle
                 estiver marcado; o conteúdo (ListBox de LogEntries) é o mesmo controle
                 realocado de dentro de CardConsoleEventos, nunca uma cópia (ver
                 MonitoramentoView.SetLogPinned). -->
            <Border x:Name="PinnedLogPanel" Grid.Column="1" Margin="8,0,0,0" Visibility="Collapsed"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="CONSOLE DE EVENTOS" Margin="12,10,12,6"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <ContentControl x:Name="PinnedLogHost" Grid.Row="1" Margin="12,0,12,12"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
