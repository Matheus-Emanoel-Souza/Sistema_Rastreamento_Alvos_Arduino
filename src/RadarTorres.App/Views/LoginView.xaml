<UserControl x:Class="RadarTorres.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RadarTorres.App.Localization"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters"
             xmlns:shared="clr-namespace:RadarTorres.App.Views.Shared"
             Background="{DynamicResource Bg.Window}"
             Foreground="{DynamicResource Text.Primary}"
             FontFamily="{DynamicResource Font.Body}">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Estilo exclusivo do campo de usuário desta tela (x:Key, não implícito por tipo):
             dá altura mínima 44 e cantos arredondados via ControlTemplate — TextBox não tem
             propriedade CornerRadius nativa, só dá pra conseguir isso retemplando. Escopado só
             a este campo (em vez de um Style implícito TargetType="TextBox") para não vazar para
             o TextBox interno do PasswordRevealBox compartilhado (Usuários/Perfil usam o mesmo
             controle sem este visual). -->
        <Style x:Key="LoginFieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mesma lógica do campo acima: Button não tem CornerRadius nativo, só via template.
             Também exclusivo desta tela (x:Key) — nenhum outro botão do app usa altura
             mínima 44/raio 10 hoje. -->
        <Style x:Key="LoginSubmitButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent.Fill}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Feedback de hover/pressed: o template substitui o chrome padrão do
                                 Button, que já dava esse retorno visual sozinho — sem isto o botão
                                 ficaria sem nenhuma reação ao mouse. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Layout 70/30: painel de arte (logo + nome) à esquerda, formulário à direita — substitui
         a antiga marca d'água esticada sobre a tela inteira (que não ficava bem centralizada em
         janelas largas) por um painel dedicado, com a logo exibida inteira (Stretch="Uniform",
         sem recorte/distorção). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*" MinWidth="340"/>
        </Grid.ColumnDefinitions>

        <!-- Painel de arte -->
        <Grid Grid.Column="0" Background="{DynamicResource Bg.Sidebar}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                <!--
                    Logo vetorial (não mais o .ico raster): o .ico tem o texto "RadarTorres" já
                    desenhado dentro da imagem, duplicando o TextBlock "Radar Torres" logo abaixo
                    — e, pior, o WPF decodifica o quadro ERRADO de um .ico multi-resolução (o
                    menor, 16x16) ao carregar via BitmapImage, então esticar para 200px sempre
                    saía borrado, não importa o DecodePixelWidth pedido. Sendo vetor (mesmo Path
                    da torre usado no logo compacto da barra lateral — ver Icon.LogoTorre), este
                    emblema nunca borra, em nenhum tamanho de tela, e não carrega texto nenhum.
                -->
                <Grid Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Linhas de mira, atravessando todo o emblema (como um reticle de mira). -->
                    <Line X1="100" Y1="5" X2="100" Y2="195" Stroke="{DynamicResource Accent.Fill}" StrokeThickness="2" Opacity="0.55"/>
                    <Line X1="5" Y1="100" X2="195" Y2="100" Stroke="{DynamicResource Accent.Fill}" StrokeThickness="2" Opacity="0.55"/>

                    <!-- Emblema circular com a torre (mesmo Path de Icon.LogoTorre). -->
                    <Ellipse Width="150" Height="150" Fill="{DynamicResource Accent.Fill}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Path Data="{StaticResource Icon.LogoTorre}" Fill="White" Stretch="Uniform"
                          Width="64" Height="94" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Cantos de mira (reticle) — três abertos, um fechado (indicador de "alvo travado"). -->
                    <Rectangle Width="16" Height="16" Stroke="{DynamicResource Accent.Fill}" StrokeThickness="2.5"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,18,0,0"/>
                    <Rectangle Width="16" Height="16" Stroke="{DynamicResource Accent.Fill}" StrokeThickness="2.5"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,18"/>
                    <Rectangle Width="16" Height="16" Stroke="{DynamicResource Accent.Fill}" StrokeThickness="2.5"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18"/>
                    <Rectangle Width="16" Height="16" Fill="#F59E0B" RadiusX="2" RadiusY="2"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0"/>
                </Grid>
                <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0"
                           FontFamily="{DynamicResource Font.Display}" FontWeight="Bold" FontSize="28">
                    <Run Text="Radar" Foreground="{DynamicResource Text.Primary}"/>
                    <Run Text="Torres" Foreground="{DynamicResource Accent.Text}"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Painel do formulário -->
        <Grid Grid.Column="1" Background="{DynamicResource Bg.Window}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="32">
                <TextBlock Text="{loc:Loc Login.Title}" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Accent.Fill}"/>
                <TextBlock Text="{loc:Loc Login.Subtitle}" FontSize="11" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,24"/>

                <TextBlock Text="{loc:Loc Login.Username}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="LoginTextBox" Style="{StaticResource LoginFieldTextBox}"
                         Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{loc:Loc Login.Password}" Style="{StaticResource FieldLabel}"/>
                <shared:PasswordRevealBox Password="{Binding Senha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           MinHeight="44" Margin="0,0,0,4"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource Danger.Fill}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                <Button Content="{loc:Loc Login.Submit}" Command="{Binding LoginCommand}"
                        Style="{StaticResource LoginSubmitButton}" IsDefault="True"/>

                <TextBlock Text="{loc:Loc Login.DefaultAdminHint}" FontSize="10"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Secondary}" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
