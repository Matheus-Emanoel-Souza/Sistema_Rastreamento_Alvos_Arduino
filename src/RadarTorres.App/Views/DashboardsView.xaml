<UserControl x:Class="RadarTorres.App.Views.DashboardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RadarTorres.App.Views"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters"
             Background="{DynamicResource Bg.Window}"
             Foreground="{DynamicResource Text.Primary}"
             FontFamily="{DynamicResource Font.Body}">
    <!--
        Tela "Dashboards" (seção "Dados") — o usuário monta os próprios gráficos escolhendo
        fonte de dados + eixo X + métrica + tipo de gráfico em combos (sem escrever SQL), a
        partir de dados já persistidos por outras telas (treinamento do controlador, experimentos
        de hiperparâmetros/rede neural). Pedido do usuário após perguntar como consultar o banco
        manualmente — ver DashboardsViewModel/IFontesDeDadosDashboardService.
    -->
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilidadeDashboards"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="ParametroLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================== TÍTULO ============================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="DASHBOARDS" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Accent.Fill}"/>
            <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Monte seus próprios gráficos a partir dos dados já persistidos pelo app (treinamento do controlador, experimentos) — escolha a fonte, o eixo X e a métrica, sem escrever consulta nenhuma."/>
        </StackPanel>

        <!-- ============================== MONTAGEM DE UM GRÁFICO NOVO ============================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="NOVO GRÁFICO" Style="{StaticResource CardTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fonte de dados" Style="{StaticResource ParametroLabel}"/>
                        <ComboBox ItemsSource="{Binding Fontes}" DisplayMemberPath="Nome" SelectedItem="{Binding FonteSelecionada}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Eixo X" Style="{StaticResource ParametroLabel}"/>
                        <ComboBox ItemsSource="{Binding CamposEixoXDisponiveis}" DisplayMemberPath="Nome" SelectedItem="{Binding CampoEixoXSelecionado}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Métrica (eixo Y)" Style="{StaticResource ParametroLabel}"/>
                        <ComboBox ItemsSource="{Binding CamposMetricaDisponiveis}" DisplayMemberPath="Nome" SelectedItem="{Binding CampoMetricaSelecionado}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6" MinWidth="110">
                        <TextBlock Text="Tipo de gráfico" Style="{StaticResource ParametroLabel}"/>
                        <ComboBox ItemsSource="{Binding TiposGraficoDisponiveis}" SelectedItem="{Binding TipoGraficoSelecionado}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Título do gráfico" Style="{StaticResource ParametroLabel}" Margin="0,10,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding TituloNovoCard, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="+ Adicionar gráfico" Command="{Binding AdicionarCommand}" Padding="12,7"/>
                    <Button Grid.Column="4" Content="Atualizar todos" Command="{Binding AtualizarTodosCommand}" Padding="12,7"
                            ToolTip="Reexecuta a consulta de todos os gráficos já montados — útil depois de um treinamento rodar mais gerações."/>
                </Grid>

                <TextBlock Text="{Binding StatusMensagem}" Margin="0,8,0,0" FontSize="12" Foreground="#F87171" TextWrapping="Wrap"
                           Visibility="{Binding StatusMensagem, Converter={StaticResource NullToVisibilidadeDashboards}}"/>
            </StackPanel>
        </Border>

        <!-- ============================== GRÁFICOS MONTADOS ============================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="420" Height="260" Margin="0,0,14,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource CardTitle}" Margin="0"/>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource Text.Muted}">
                                            <Run Text="{Binding FonteNome, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Command="{Binding RemoverCommand}"
                                            ToolTip="Remover este gráfico" Padding="6,2" Background="Transparent"
                                            BorderThickness="0" Foreground="{DynamicResource Text.Muted}" Cursor="Hand"/>
                                </DockPanel>

                                <local:GraficoCartesianoView Grid.Row="1" Pontos="{Binding Pontos}" TipoGrafico="{Binding TipoGrafico}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
