<Window x:Class="RadarTorres.App.Views.EstatisticasAnaliseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estatísticas e Análises"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Font.Body}">

    <!--
        Janela "Estatísticas e Análises" — hospeda a MESMA EstatisticasTreinamentoView (3 abas:
        Visão geral / Experimentos / Marcos) que antes era uma tela própria do menu lateral.
        Não-modal (.Show(), não .ShowDialog() — ver TreinamentoControladorView.
        BotaoEstatisticasEAnalises_Click): abrir/fechar este painel não pausa nem reinicia o
        treinamento em andamento, que continua rodando em segundo plano na janela principal.

        Dimensão inicial ~80% x 85% da área de trabalho, calculada no code-behind (Loaded) a
        partir de SystemParameters.WorkArea — não dá para expressar "80% da tela" só em XAML.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título própria: fechar e maximizar/restaurar, pedidos explicitamente — a
             borda padrão do Windows já dá os três botões, mas o pedido foi por botões no próprio
             painel, então ficam duplicados aqui de propósito (funcionam mesmo se o usuário tirar
             a borda do SO no futuro). -->
        <Border Grid.Row="0" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Divider}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <TextBlock Text="ESTATÍSTICAS E ANÁLISES" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource Accent.Fill}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="▢ Maximizar/Restaurar" Click="BotaoMaximizarRestaurar_Click" Padding="10,5" Margin="0,0,8,0"
                            Background="{DynamicResource Border.Control}" Foreground="{DynamicResource Text.Primary}" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="✕ Fechar" Click="BotaoFechar_Click" Padding="10,5"
                            Background="{DynamicResource Border.Control}" Foreground="{DynamicResource Text.Primary}" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- O conteúdo (EstatisticasTreinamentoView) já tem sua própria rolagem interna por aba
             — este Grid não adiciona outra, conforme pedido ("rolagem interna apenas no
             conteúdo do painel"). -->
        <ContentPresenter Grid.Row="1" x:Name="ConteudoApresentador" Margin="20"/>
    </Grid>
</Window>
