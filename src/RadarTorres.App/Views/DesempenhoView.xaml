<UserControl x:Class="RadarTorres.App.Views.DesempenhoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI">
    <!--
        Tela "Desempenho": monitora em tempo real a taxa de atualização do radar e o tempo do
        ciclo detecção -> seleção de torre (ver DesempenhoViewModel/PerformanceMonitorService).
    -->
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style x:Key="CardUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style x:Key="StatLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="DESEMPENHO" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Métricas operacionais em tempo real do ciclo de detecção e seleção de torre."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="Zerar estatísticas" Command="{Binding ZerarEstatisticasCommand}"
                    Padding="10,5" Margin="24,0,0,0" Cursor="Hand"
                    Background="{DynamicResource PanelBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderThickness="0"/>
        </StackPanel>

        <UniformGrid Columns="2" Rows="2">
            <!-- Taxa de atualização do radar -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="TAXA DE ATUALIZAÇÃO DO RADAR" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding TaxaMedidaHz, StringFormat={}{0:0.0}}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="Hz" Style="{StaticResource CardUnit}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource StatLine}">
                        <Run Text="Configurada: "/>
                        <Run Text="{Binding TaxaConfiguradaHz, StringFormat={}{0:0.0}, Mode=OneWay}"/>
                        <Run Text=" Hz"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Tempo de decisão -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="TEMPO DE DECISÃO (DETECÇÃO → SELEÇÃO DE TORRE)" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding DecisaoUltimoMs, StringFormat={}{0:0.00}}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="ms" Style="{StaticResource CardUnit}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource StatLine}">
                        <Run Text="Média: "/><Run Text="{Binding DecisaoMediaMs, StringFormat={}{0:0.00}, Mode=OneWay}"/>
                        <Run Text=" ms · Mín: "/><Run Text="{Binding DecisaoMinimoMs, StringFormat={}{0:0.00}, Mode=OneWay}"/>
                        <Run Text=" ms · Máx: "/><Run Text="{Binding DecisaoMaximoMs, StringFormat={}{0:0.00}, Mode=OneWay}"/>
                        <Run Text=" ms"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource StatLine}">
                        <Run Text="Amostras na janela: "/><Run Text="{Binding DecisaoAmostras, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Tempo de ciclo completo -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="TEMPO DE CICLO COMPLETO" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CicloUltimoMs, StringFormat={}{0:0.00}}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="ms" Style="{StaticResource CardUnit}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource StatLine}">
                        <Run Text="Média: "/><Run Text="{Binding CicloMediaMs, StringFormat={}{0:0.00}, Mode=OneWay}"/>
                        <Run Text=" ms · Mín: "/><Run Text="{Binding CicloMinimoMs, StringFormat={}{0:0.00}, Mode=OneWay}"/>
                        <Run Text=" ms · Máx: "/><Run Text="{Binding CicloMaximoMs, StringFormat={}{0:0.00}, Mode=OneWay}"/>
                        <Run Text=" ms"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource StatLine}">
                        <Run Text="Amostras na janela: "/><Run Text="{Binding CicloAmostras, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Jitter do tempo de decisão -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="JITTER DO TEMPO DE DECISÃO" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding DecisaoJitterMs, StringFormat={}{0:0.00}}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="ms" Style="{StaticResource CardUnit}"/>
                    </StackPanel>
                    <TextBlock Text="Média da variação entre um tempo de decisão e o anterior — quanto mais perto de zero, mais estável."
                               Style="{StaticResource StatLine}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </DockPanel>
</UserControl>
