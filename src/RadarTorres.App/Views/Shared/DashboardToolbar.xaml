<UserControl x:Class="RadarTorres.App.Views.Shared.DashboardToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RadarTorres.App.Localization">
    <!--
        Barra de ações de layout, reutilizada pelo painel principal e pelo Monitoramento
        (Requisito "mesmo padrão de flexibilização... em todas as telas"). Não conhece
        DashboardCanvas nem repositório algum — só expõe eventos (Click dos botões) e um método
        para popular o menu de painéis ocultos; quem hospeda o controle (code-behind da View) é
        quem efetivamente mexe no DashboardCanvas e no IDashboardLayoutRepository, mesmo
        princípio já usado em DashboardCard.
    -->
    <UserControl.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <WrapPanel Orientation="Horizontal">
            <Button x:Name="SaveMyLayoutButton" Style="{StaticResource ToolbarButton}"
                    Content="{loc:Loc Dashboard.DefinirLayoutPadrao}"
                    ToolTip="{loc:Loc Dashboard.DefinirLayoutPadraoDica}"
                    Click="SaveMyLayoutButton_Click"/>
            <Button x:Name="SystemDefaultButton" Style="{StaticResource ToolbarButton}"
                    Content="{loc:Loc Dashboard.RestaurarPadraoSistema}"
                    ToolTip="{loc:Loc Dashboard.RestaurarPadraoSistemaDica}"
                    Click="SystemDefaultButton_Click"/>
            <Button x:Name="MyLayoutButton" Style="{StaticResource ToolbarButton}"
                    Content="{loc:Loc Dashboard.RetornarMeuLayout}"
                    ToolTip="{loc:Loc Dashboard.RetornarMeuLayoutDica}"
                    Click="MyLayoutButton_Click"/>
            <Button x:Name="HiddenPanelsButton" Style="{StaticResource ToolbarButton}"
                    Click="HiddenPanelsButton_Click"/>
        </WrapPanel>

        <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsSuccess, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
