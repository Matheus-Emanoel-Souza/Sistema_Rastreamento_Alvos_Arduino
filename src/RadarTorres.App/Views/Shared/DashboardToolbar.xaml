<UserControl x:Class="RadarTorres.App.Views.Shared.DashboardToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RadarTorres.App.Localization"
             xmlns:conv="clr-namespace:RadarTorres.App.Converters">
    <!--
        Barra de ações de layout, reutilizada pelo painel principal e pelo Monitoramento
        (Requisito "mesmo padrão de flexibilização... em todas as telas"). Não conhece
        DashboardCanvas nem repositório algum — só expõe eventos (Click dos botões) e um método
        para popular o menu de painéis ocultos; quem hospeda o controle (code-behind da View) é
        quem efetivamente mexe no DashboardCanvas e no IDashboardLayoutRepository, mesmo
        princípio já usado em DashboardCard.

        Reagrupamento puramente visual (identidade nova): os mesmos 4 comandos de antes — nenhum
        novo, nenhum removido — agora aparecem como "Meu layout" / "Padrão do sistema" lado a
        lado (seletor segmentado), "Salvar como padrão" como botão secundário, e o antigo botão
        "Painéis ocultos" virou "+ Adicionar painel" (borda tracejada), mantendo exatamente a
        mesma função de reabrir painéis ocultados — ver DashboardToolbar.xaml.cs.
    -->
    <UserControl.Resources>
        <conv:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometryConverter"/>

        <!-- Item do modal "+ Adicionar painel": ícone do tipo de painel + nome, linha inteira
             clicável para reimportar o painel oculto na tela (Requisito: substituir o menu
             esbranquiçado por um modal legível, com imagens dos tipos disponíveis). -->
        <Style x:Key="HiddenPanelItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Selection.Subtle}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão tracejado — usado só em "+ Adicionar painel" (Requisito). WPF não tem borda
             tracejada nativa num Border simples, por isso o Rectangle com StrokeDashArray por
             cima no lugar da BorderBrush do Border. -->
        <Style x:Key="DashedButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle RadiusX="10" RadiusY="10" Stroke="{DynamicResource Border.Control}"
                                       StrokeThickness="1" StrokeDashArray="3,3"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent.Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Seletor segmentado: mesma função de MyLayoutButton/SystemDefaultButton de
                     antes, só reagrupados numa pílula em vez de 2 botões soltos. -->
                <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Control}"
                        BorderThickness="1" CornerRadius="10" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MyLayoutButton" Style="{StaticResource SegmentButton}"
                                Content="{loc:Loc Dashboard.RetornarMeuLayout}"
                                ToolTip="{loc:Loc Dashboard.RetornarMeuLayoutDica}"
                                Click="MyLayoutButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource Selection.Solid}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextElement.Foreground="{DynamicResource Text.Primary}"
                                                           TextElement.FontWeight="SemiBold"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="SystemDefaultButton" Style="{StaticResource SegmentButton}"
                                Content="{loc:Loc Dashboard.RestaurarPadraoSistema}"
                                ToolTip="{loc:Loc Dashboard.RestaurarPadraoSistemaDica}"
                                Click="SystemDefaultButton_Click"/>
                    </StackPanel>
                </Border>

                <Button x:Name="SaveMyLayoutButton" Style="{StaticResource SecondaryButton}"
                        Content="{loc:Loc Dashboard.DefinirLayoutPadrao}"
                        ToolTip="{loc:Loc Dashboard.DefinirLayoutPadraoDica}"
                        Click="SaveMyLayoutButton_Click"/>
            </StackPanel>

            <Button x:Name="HiddenPanelsButton" Grid.Column="1" Style="{StaticResource DashedButton}"
                    Click="HiddenPanelsButton_Click"/>

            <!-- Modal sobreposto (Popup) com os tipos de painel ocultos disponíveis para
                 reimportar — substitui o antigo ContextMenu padrão do Windows (fundo e texto
                 esbranquiçados, fora do padrão visual). Popup flutua acima de toda a tela,
                 então o conteúdo continua legível mesmo a partir de uma barra estreita como
                 esta. -->
            <Popup x:Name="HiddenPanelsPopup" Grid.Column="1" PlacementTarget="{Binding ElementName=HiddenPanelsButton}"
                   Placement="Bottom" HorizontalOffset="0" VerticalOffset="8"
                   AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Control}"
                        BorderThickness="1" CornerRadius="12" Padding="8" MinWidth="260" MaxWidth="320">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dashboard.PaineisOcultos}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Secondary}" Margin="6,2,6,8"/>
                        <ItemsControl x:Name="HiddenPanelsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource HiddenPanelItemButton}" Tag="{Binding CardId}"
                                            Click="HiddenPanelItem_Click"
                                            ToolTip="Adicionar este painel de volta à tela"
                                            AutomationProperties.Name="{Binding Title}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="8"
                                                    Background="{DynamicResource Bg.Sidebar}"
                                                    BorderBrush="{DynamicResource Border.Control}" BorderThickness="1">
                                                <Path Data="{Binding IconKey, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                                                      Stroke="{DynamicResource Accent.Text}" StrokeThickness="2"
                                                      Stretch="Uniform" Width="16" Height="16"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Text.Primary}"
                                                       FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                   FontFamily="{DynamicResource Font.Body}" FontSize="13"
                   Visibility="Collapsed">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Danger.Text}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsSuccess, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent.Text}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
