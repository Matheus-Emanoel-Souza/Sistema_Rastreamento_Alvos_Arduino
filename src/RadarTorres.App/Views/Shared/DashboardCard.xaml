<UserControl x:Class="RadarTorres.App.Views.Shared.DashboardCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Card arrastável/redimensionável do painel principal. Deve ser filho direto de um
        DashboardCanvas, que é quem efetivamente aplica o movimento/redimensionamento (com
        verificação de colisão) quando os Thumbs abaixo disparam DragDelta — ver
        DashboardCanvas.RequestMove/RequestResize. O conteúdo do card é definido por quem usa o
        controle (ex.: <shared:DashboardCard Title="...">...conteúdo...</shared:DashboardCard>),
        mapeado para a propriedade CardContent via [ContentProperty] no code-behind.
    -->
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho: arrasta o card inteiro (Requisito "arrastar e reposicionar"). -->
            <Thumb x:Name="HeaderThumb" Grid.Row="0" Cursor="SizeAll" Background="Transparent"
                   DragDelta="HeaderThumb_DragDelta" DragCompleted="HeaderThumb_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource PanelBorderBrush}" CornerRadius="8,8,0,0" Padding="12,7">
                            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- Conteúdo do card, definido por quem usa o controle. -->
            <ContentPresenter Grid.Row="1" Margin="16,12"
                               Content="{Binding CardContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <!-- Alça de redimensionamento no canto inferior direito (Requisito "redimensionar
                 individualmente"). -->
            <Thumb x:Name="ResizeThumb" Grid.Row="1" Width="16" Height="16"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Background="Transparent"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Path Data="M 2,14 L 14,14 L 14,2 Z" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.55"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
