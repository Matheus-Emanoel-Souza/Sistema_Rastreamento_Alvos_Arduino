<UserControl x:Class="RadarTorres.App.Views.Shared.PasswordRevealBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RadarTorres.App.Localization">
    <!--
        Campo de senha com botão de "olho" para mostrar/ocultar o texto digitado. WPF não
        permite Binding direto de PasswordBox.Password (proteção de segurança do próprio
        framework), então este controle mantém um PasswordBox (oculto) e um TextBox (visível)
        sincronizados por código, alternando qual dos dois fica visível — e expõe uma única
        propriedade "Password" bindável normalmente (TwoWay) para quem usa o controle.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <PasswordBox x:Name="HiddenBox"
                         Padding="8,7" Margin="0"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource PanelBorderBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         FontSize="14"
                         PasswordChanged="HiddenBox_PasswordChanged"/>
            <TextBox x:Name="VisibleBox"
                     Padding="8,7" Margin="0"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource PanelBorderBrush}"
                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                     FontSize="14"
                     Visibility="Collapsed"
                     TextChanged="VisibleBox_TextChanged"/>
        </Grid>

        <ToggleButton x:Name="RevealToggle" Grid.Column="1"
                      Width="34" Margin="4,0,0,0"
                      Background="Transparent" BorderThickness="1"
                      BorderBrush="{DynamicResource PanelBorderBrush}"
                      Cursor="Hand"
                      Checked="RevealToggle_Checked"
                      Unchecked="RevealToggle_Unchecked"
                      ToolTip="{loc:Loc Common.MostrarSenha}">
            <TextBlock x:Name="ToggleGlyph" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </ToggleButton>
    </Grid>
</UserControl>
